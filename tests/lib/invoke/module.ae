// invoke: the host half of the shared tests in the new direction, the host
// calling the guest (std.guest's INVOKE; tests/boundary.py run-invoke). Every
// language's child_host.ae calls invoke.run with the worker it launched and a
// script written in that language (the x: snippets in
// <lang>/containment/boundary.tsv). The host mounts the boundary tests' four
// functions and three more, runs the script until the guest serves (READY) or
// ends, then follows a plan, and prints every event, one line each, for
// tests/boundary.py to judge:
//
//   echo(v)          answers with its argument; "WIRE <n> <args>" says what
//                    the worker put on the wire
//   give(id)         answers with the JSON in $GHL_BOUNDARY_GIVE
//   refuse(m)        answers FAIL
//   slow(x)          never answers: the host's deadline cancels it
//   txn_start(kind)  starts a transaction: answers its id at once, a string
//                    ("123456", then "123457", ...); the details wait
//   txn_details(id)  the details of a started transaction, an object
//                    {"id": id, "kind": kind, "amount": 100 * n}, or FAIL
//                    "no transaction <id>"
//   reenter(x)       while answering, tries to invoke the guest's `back`:
//                    std.guest refuses (the guest is not serving), and
//                    "NOSEND <n> <why>" says so; then answers with x
//
// The plan ($GHL_INVOKE_PLAN) is one step a line:
//
//   I<TAB>name<TAB>args   invoke `name` with `args` (a JSON array), then answer
//                         the guest's calls until RETURN or RAISE
//   E                     end the guest (END), then read until it has ended
//   A<TAB>name<TAB>args   try to invoke after the guest has ended
//
// Output lines are "TAG <n> <text>", length-prefixed so that nothing the guest
// chose can forge or split another: READY, RETURN, RAISE, NOSEND, WIRE, SAY,
// CALL (the name of every host call), and END for the event that ended the
// guest. Nothing here knows a language.

exports(run)

import std.guest
import std.list
import std.os
import std.string

extern exit(code: int)

fn first_arg(args: string) -> string {
    return string.trim(string.substring(args, 1, string.length(args) - 1))
}

fn unquote(v: string) -> string {
    if string.starts_with(v, "\"") == 1 && string.length(v) >= 2 {
        return string.substring(v, 1, string.length(v) - 1)
    }
    return v
}

fn emit(tag: string, t: string) {
    println("${tag} ${string.length(t)} ${t}")
}

// The host's transactions: kinds by number, the first is "123456".
const TXN_BASE = 123456

// Answers one host call. txns is the list of started transactions' kinds.
fn answer_call(g: *guest.Guest, e: guest.Event, txns: ptr) {
    name = string.to_lower(e.name)
    emit("CALL", name)
    if name == "echo" {
        emit("WIRE", e.text)
        guest.answer(g, first_arg(e.text))
    } else if name == "give" {
        guest.answer(g, os.getenv("GHL_BOUNDARY_GIVE"))
    } else if name == "refuse" {
        guest.fail(g, "refused by the host")
    } else if name == "slow" {
    } else if name == "txn_start" {
        list.add(txns, unquote(first_arg(e.text)))
        guest.answer(g, guest.json_string("${TXN_BASE + list.size(txns) - 1}"))
    } else if name == "txn_details" {
        id = unquote(first_arg(e.text))
        n, nerr = string.to_int(id)
        k = n - TXN_BASE
        if nerr != "" || k < 0 || k >= list.size(txns) {
            guest.fail(g, "no transaction ${id}")
        } else {
            kind, _ke = list.get_string(txns, k)
            guest.answer(g, "{\"id\":${guest.json_string(id)},\"kind\":${guest.json_string(kind)},\"amount\":${100 * (k + 1)}}")
        }
    } else if name == "reenter" {
        why = guest.invoke(g, "back", "[1]")
        if why == "" { emit("SENT", "invoke went out while the guest was in a call") } else { emit("NOSEND", why) }
        guest.answer(g, first_arg(e.text))
    } else {
        guest.fail(g, "no host function ${e.name}")
    }
}

// Reads events, answering calls, until one that is not SAY, LOG or CALL:
// READY, RETURN, RAISE, or how the guest ended. It is printed, and returned.
fn until_settled(g: *guest.Guest, txns: ptr) -> guest.Event {
    while true {
        e = guest.next(g)
        if e.kind == "SAY" {
            emit("SAY", e.text)
        } else if e.kind == "CALL" {
            answer_call(g, e, txns)
        } else if e.kind == "LOG" {
        } else {
            if e.kind == "READY" || e.kind == "RETURN" || e.kind == "RAISE" {
                emit(e.kind, e.text)
            } else if e.kind == "DONE" {
                emit("END", "DONE ${e.code}")
            } else {
                emit("END", "${e.kind} ${e.text}")
            }
            return e
        }
    }
    return guest.next(g)
}

fn ended(kind: string) -> int {
    if kind == "READY" || kind == "RETURN" || kind == "RAISE" { return 0 }
    return 1
}

run(g: *guest.Guest, script: string) -> int {
    names = ["echo", "give", "refuse", "slow", "txn_start", "txn_details", "reenter"]
    upper = os.getenv("GHL_BOUNDARY_UPPER") == "1"
    for name in names {
        if upper { guest.mount(g, string.to_upper(name), 1, 1) } else { guest.mount(g, name, 1, 1) }
    }
    g.deadline_ms = 1500
    g.grace_ms = 1000
    txns = list.new()
    guest.start(g, script)
    e = until_settled(g, txns)
    over = ended(e.kind)
    steps = string.split(os.getenv("GHL_INVOKE_PLAN"), "\n")
    ns = string.array_size(steps)
    i = 0
    while i < ns {
        step = string.copy(string.array_get(steps, i))
        i = i + 1
        if string.length(step) == 0 { continue }
        parts = string.split(step, "\t")
        op = string.copy(string.array_get(parts, 0))
        fname = ""
        fargs = "[]"
        if string.array_size(parts) >= 3 {
            fname = string.copy(string.array_get(parts, 1))
            fargs = string.copy(string.array_get(parts, 2))
        }
        string.array_free(parts)
        if op == "A" {
            why = guest.invoke(g, fname, fargs)
            if why == "" { emit("SENT", "invoke went out to a guest that had ended") } else { emit("NOSEND", why) }
            continue
        }
        if over == 1 { break }
        if op == "E" {
            why = guest.end(g)
            if why != "" {
                emit("NOSEND", why)
                continue
            }
            e = until_settled(g, txns)
            over = ended(e.kind)
        } else if op == "I" {
            why = guest.invoke(g, fname, fargs)
            if why != "" {
                emit("NOSEND", why)
                continue
            }
            e = until_settled(g, txns)
            over = ended(e.kind)
        }
    }
    string.array_free(steps)
    // A guest still serving when the plan ran out is ended here, so every run
    // has one END line.
    if over == 0 {
        if guest.end(g) == "" { until_settled(g, txns) }
    }
    list.free(txns)
    guest.close(g)
    return 0
}
