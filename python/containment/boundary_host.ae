// The shared boundary tests (tests/boundary.py) against CPython's in-process
// bridge, through the API it really has: python.vm_*, a callback's typed arg_*
// readers and push_* writers. Usage: boundary_host (the script and the value to
// give come from the environment; tests/lib/inproc says which).
//
// echo(v) prints what the typed readers say it received and answers with it;
// give(id) builds the harness's value with the typed writers, as far as the
// bridge has one (no table builder); refuse(m) raises an error. Nothing here widens the
// bridge: a value it loses is the result, and a case it cannot express prints
// NOAPI and reads n/a.

import python
import inproc
import std.json
import std.string

extern exit(code: int)

fn render(vm: ptr, i: int) -> string {
    t = python.arg_type(vm, i)
    if t == python.PY_TNIL { return "null" }
    if t == python.PY_TBOOL {
        if python.arg_bool(vm, i) == 1 { return "true" }
        return "false"
    }
    if t == python.PY_TINT { return "${python.arg_int(vm, i)}" }
    if t == python.PY_TFLOAT { return "${python.arg_double(vm, i)}" }
    if t == python.PY_TSTR { return inproc.quote(python.arg_str(vm, i)) }
    if t == python.PY_TTABLE { return "\"<a table>\"" }
    return "\"<other type ${t}>\""
}

@c_callback
host_echo(vm: ptr) -> int {
    n = python.arg_count(vm)
    out = "["
    i = 1
    while i <= n {
        if i > 1 { out = "${out}," }
        out = "${out}${render(vm, i)}"
        i = i + 1
    }
    inproc.emit("WIRE", "${out}]")
    if n < 1 { return 0 }
    t = python.arg_type(vm, 1)
    if t == python.PY_TSTR { python.push_str(vm, python.arg_str(vm, 1)) }
    else if t == python.PY_TINT { python.push_int(vm, python.arg_int(vm, 1)) }
    else if t == python.PY_TBOOL { python.push_bool(vm, python.arg_bool(vm, 1)) }
    else if t == python.PY_TFLOAT { python.push_double(vm, python.arg_double(vm, 1)) }
    else { python.push_nil(vm) }
    return 1
}

@c_callback
host_refuse(vm: ptr) -> int {
    inproc.emit("REFUSE", "")
    return python.raise_error(vm, "refused by the host")
}

@c_callback
host_give(vm: ptr) -> int {
    v, err = json.parse(inproc.give_text())
    if err != "" {
        inproc.emit("NOAPI", "the harness's value is not JSON: ${err}")
        return 0
    }
    kind = json.type(v)
    if kind == json.JSON_NULL { python.push_nil(vm); return 1 }
    if kind == json.JSON_BOOL { python.push_bool(vm, json.json_get_bool(v)); return 1 }
    if kind == json.JSON_STRING {
        s, _x = json.get_string(v)
        python.push_str(vm, s)
        return 1
    }
    if kind == json.JSON_NUMBER {
        if json.json_is_integer(v) == 1 {
            python.push_int(vm, json.json_get_long(v))
        } else {
            python.push_double(vm, json.json_get_number(v))
        }
        return 1
    }
    inproc.emit("NOAPI", "the bridge has no table builder: a list or a dict cannot be pushed")
    return 0
}

main() {
    vm = python.vm_new()
    if vm == null { println("no python runtime"); exit(2) }
    python.vm_register(vm, "echo", host_echo)
    python.vm_register(vm, "give", host_give)
    python.vm_register(vm, "refuse", host_refuse)
    if inproc.limited() == 1 {
        why = python.vm_set_instruction_limit(vm, 200000, 100)
        if why != "" {
            inproc.emit("NOAPI", why)
            exit(0)
        }
    }
    rc = python.vm_eval(vm, inproc.script())
    if rc == 0 { inproc.emit("END", "DONE ") } else { inproc.emit("END", "ERROR ${python.vm_result_str(vm)}") }
    python.vm_free(vm)
    exit(0)
}
