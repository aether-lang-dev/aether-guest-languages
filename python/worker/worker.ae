// python-worker: CPython in a contained child, the guest's side of
// std.guest.
//
// A host starts this with guest.launch (sandbox.spawn_socket: Landlock and
// seccomp on Linux; refused on macOS and Windows, where nothing starts) and
// sends it the functions it may call (MOUNT) and a Python script (SCRIPT).
// The worker loads libpython and starts the interpreter before it locks
// itself down, imports the modules the host names, then runs the script in
// the bridge's two-way VM inside std.guest.child's lockdown:
//
//   print(...)          SAY, the arguments str()'d and joined by sep
//   NAME(...)           for each mounted NAME: CALL NAME [args as JSON], the
//                       host's answer decoded back to Python (a granted file
//                       is {"granted": True, "text": ...}); a FAIL raises
//                       RuntimeError(message); a CANCEL raises
//                       RuntimeError("cancelled by host: ...")
//   the end             DONE 0, or ERROR and "<ExceptionType>: <message>"
//
// Usage (by a host): python-worker [<libpython soname or path> [<modules>]]
//
// <modules> is a comma list of modules to import before the lockdown.
// CPython imports a module by reading it from disk the first time it is
// imported; once the worker has locked itself down it can read nothing, so
// a module the script imports that is not imported by then fails to import
// (PermissionError, or ModuleNotFoundError where the finder could not list
// the directory). The interpreter's own start (encodings, site) happens
// before the lockdown too. Builtin and frozen modules (sys, time, os on 3.11
// and later) need no disk.
//
// A CANCEL is looked for every 1000 trace events from a sys.settrace hook
// (std.guest's "interrupt hook" engine), and in every call's reply. A script
// that removes the hook (or catches the RuntimeError, after which CPython
// removes a Python-level trace function itself) stops answering, and the
// host kills it after its grace period: the containment is the host's, not
// the hook's.

import python
import std.guest.child
import std.os
import std.string

extern exit(code: int)
extern setenv(name: string, value: string, overwrite: int) -> int
extern ghl_keep(p: ptr)
extern ghl_kept() -> ptr

@source("worker_support.c")

// The Host the callbacks below answer through (one per process).
fn host() -> *child.Host {
    return ghl_kept() as *child.Host
}

// __say(text)
@c_callback
w_say(vm: ptr) -> int {
    child.say(host(), python.arg_str(vm, 1))
    return 0
}

// __call(name, args_json) -> "KIND\ntext"
@c_callback
w_call(vm: ptr) -> int {
    r = child.call_host(host(), python.arg_str(vm, 1), python.arg_str(vm, 2))
    python.push_str(vm, "${r.kind}\n${r.text}")
    return 1
}

// __poll() -> "" or the reason the host cancelled
@c_callback
w_poll(vm: ptr) -> int {
    python.push_str(vm, child.poll(host()))
    return 1
}

// The glue between Python and the protocol, run before the script.
fn prelude() -> string {
    return <<PY
import json as _json, sys as _sys
_say, _call, _poll = __say, __call, __poll
del __say, __call, __poll

def print(*args, sep=" ", end="\n", file=None, flush=False):
    _say(sep.join(str(a) for a in args))

def _mount(name):
    def call(*args):
        kind, _, text = _call(name, _json.dumps(list(args))).partition("\n")
        if kind == "VALUE":
            return _json.loads(text)
        if kind == "CANCEL":
            raise RuntimeError("cancelled by host: " + text)
        raise RuntimeError(text)
    call.__name__ = name
    return call

for _n in __MOUNTS:
    globals()[_n] = _mount(_n)
del _n, __MOUNTS

_events = [0]

def _hook(frame, event, arg):
    _events[0] += 1
    if _events[0] % 1000 == 0:
        why = _poll()
        if why:
            raise RuntimeError("cancelled by host: " + why)
    return _hook

_sys.settrace(_hook)
PY
}

// The mounted names, as a Python list literal.
fn mounts_py(h: *child.Host) -> string {
    out = "__MOUNTS = ["
    n = child.mount_count(h)
    i = 0
    while i < n {
        name, _min, _max = child.mount_at(h, i)
        out = "${out}\"${name}\","
        i = i + 1
    }
    return "${out}]\n"
}

main() {
    h, err = child.open("python-worker")
    if err != "" {
        println(err)
        exit(2)
    }
    if child.read_script(h) != "" { exit(1) }
    // libpython is loaded and the interpreter started here, before the
    // lockdown: afterwards the worker opens nothing. guest.launch gives the
    // worker no environment, so the host names the library as the first
    // argument.
    if os.args_count() > 1 && os.args_get(1) != "" {
        setenv("AETHER_PYTHON_SONAME", os.args_get(1), 1)
    }
    vm = python.vm_new()
    if vm == null {
        child.error(h, "python-worker: cannot load libpython (AETHER_PYTHON_SONAME)")
        exit(1)
    }
    if os.args_count() > 2 && os.args_get(2) != "" {
        mods = os.args_get(2)
        if python.vm_eval(vm, "import ${mods}") != 0 {
            child.error(h, "python-worker: cannot import ${mods}: ${python.vm_result_str(vm)}")
            exit(1)
        }
        python.vm_pop_result(vm)
    }
    ghl_keep(h as ptr)
    python.vm_register(vm, "__say", w_say)
    python.vm_register(vm, "__call", w_call)
    python.vm_register(vm, "__poll", w_poll)
    if python.vm_eval(vm, "${mounts_py(h)}${prelude()}") != 0 {
        child.error(h, "python-worker: the prelude failed: ${python.vm_result_str(vm)}")
        exit(1)
    }
    python.vm_pop_result(vm)
    child.run(h) callback {
        if python.vm_eval(vm, h.source) == 0 {
            child.done(h, 0)
        } else {
            child.error(h, python.vm_result_str(vm))
        }
    }
    exit(0)
}
