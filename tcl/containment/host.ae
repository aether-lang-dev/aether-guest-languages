// The host the containment tests drive (tests/test_stunt_*.sh). Usage:
//
//   host inproc <policy> <check> <expectation>
//
// Runs one row of stunt's catalogue (aether contrib/host/stunt), written in
// Tcl (checks.tcl beside this, or $TCL_CHECKS), in the Tcl bridge in this
// process, under the policy's grants, and prints stunt's line for it:
//
//   <check>: <outcome> (<detail>) - expected <expectation>: PASS|FAIL
//
// exiting 0 when it matched. Run it under libaether_sandbox.so (LD_PRELOAD)
// for Tcl's own libc calls (open, socket, exec, load) to be checked:
// in-process, nothing else sees them.
//
// Two of the bridge's entry points carry a row:
//   - tcl.run_sandboxed_with_map, the bridge's own sandboxed run, for the
//     rows Tcl's built-in commands do (open-*, write-*, env-cached,
//     connect-*, exec-bin-sh, dlopen-*) and the shared-map rows. The line
//     comes back through the map, as an output the script writes.
//   - the two-way VM (tcl.vm_*) inside sandbox.enforce, for the rows that
//     call host commands (binding-*, callback-*) and for spin, which needs
//     the time limit (a loop of no commands is not bounded by the command
//     limit). read_file and getenv check the grants themselves, as stunt's
//     host does, and refuse by failing the command with "refused: ...".
//
// Tcl_Init reads init.tcl from the Tcl library directory, and the shared
// interpreter and a VM are made with it, so both are made before any
// sandbox is in force, as a host does for a script it lends them to
// (tcl/README.md, "In a contained child" says what it takes after).
//
// <policy> is "-" for no grants, or kind=pattern,... with kinds fs_read,
// fs_write, exec, env, tcp (host:port), native, fork. "<outer>|<inner>"
// runs the check inside sandbox.enforce(<outer>), so the bridge's level
// nests in the block's. The policy grammar is in policy/module.ae; the
// contained child's host is child_host.ae.

@source("host_support.c")

import tcl
import policy
import std.sandbox
import std.os
import std.fs
import std.list
import std.string

extern exit(code: int)
extern aether_sandbox_depth() -> int
// 1 when every level in force grants it (runtime/aether_sandbox.h).
extern aether_sandbox_check_slow(category: string, resource: string) -> int
extern ghl_map_new() -> long
extern ghl_map_put(key: string, value: string)
extern ghl_map_get(key: string) -> string

// ---- host functions the guest calls (the two-way VM) ------------------------

// read_file(path): the file's text; fails with "refused: ..." when the grants
// do not allow reading it, or with the error.
@c_callback
host_read_file(vm: ptr) -> int {
    path = tcl.arg_str(vm, 1)
    if aether_sandbox_check_slow("fs_read", path) == 0 {
        return tcl.raise_error(vm, "refused: fs_read ${path}")
    }
    text, err = fs.read(path)
    if err != "" { return tcl.raise_error(vm, err) }
    tcl.push_str(vm, text)
    return 1
}

// getenv(name): the variable; fails with "refused: ..." when the grants do not
// allow it, or "<name> is unset".
@c_callback
host_getenv(vm: ptr) -> int {
    name = tcl.arg_str(vm, 1)
    if aether_sandbox_check_slow("env", name) == 0 {
        return tcl.raise_error(vm, "refused: env ${name}")
    }
    v = os.getenv(name)
    if v == "" { return tcl.raise_error(vm, "${name} is unset") }
    tcl.push_str(vm, v)
    return 1
}

@c_callback
host_greet(vm: ptr) -> int {
    tcl.push_str(vm, "hello, ${tcl.arg_str(vm, 1)}")
    return 1
}

@c_callback
host_add(vm: ptr) -> int {
    // A word in a Tcl script is a string until something uses it as a number
    // (tcl.arg_type says TCL_TSTR for the 2 in `add 2 40`), so the arguments
    // are checked by parsing them.
    x, xe = string.to_int(tcl.arg_str(vm, 1))
    y, ye = string.to_int(tcl.arg_str(vm, 2))
    if xe != "" || ye != "" { return tcl.raise_error(vm, "add takes two ints") }
    tcl.push_int(vm, x + y)
    return 1
}

// ---- the rows ---------------------------------------------------------------

// Which entry point carries a row: the two-way VM for host commands and
// spin, the bridge's sandboxed run for the rest.
fn uses_vm(check: string) -> int {
    if string.starts_with(check, "binding-") == 1 { return 1 }
    if string.starts_with(check, "callback-") == 1 { return 1 }
    if check == "spin" { return 1 }
    return 0
}

// The VM, made (and its commands registered) before any sandbox is in force.
fn make_vm() -> ptr {
    vm = tcl.vm_new()
    if vm == null {
        println("host: cannot load libtcl (AETHER_TCL_SONAME)")
        exit(1)
    }
    tcl.vm_register(vm, "read_file", host_read_file)
    tcl.vm_register(vm, "getenv", host_getenv)
    tcl.vm_register(vm, "greet", host_greet)
    tcl.vm_register(vm, "add", host_add)
    return vm
}

fn run_vm(vm: ptr, g: sandbox.Grants, check: string, expect: string, source: string) -> string {
    box = list.new()
    if check == "spin" {
        tcl.vm_set_time_limit(vm, 300, 1)
        sandbox.enforce(g) callback {
            rc = tcl.vm_eval(vm, "${source}\nwhile 1 {}")
            list.add(box, "${rc}\t${tcl.vm_result_str(vm)}")
        }
        out, _e = list.get_string(box, 0)
        tab = string.index_of(out, "\t")
        rc_text = string.substring(out, 0, tab)
        msg = string.substring(out, tab + 1, string.length(out))
        if rc_text != "0" && string.contains(msg, "time limit") == 1 {
            return "spin: stopped at the time limit (${msg}) - host-checked: PASS"
        }
        return "spin: rc ${rc_text} (${msg}) - host-checked: FAIL"
    }
    sandbox.enforce(g) callback {
        rc = tcl.vm_eval(vm, "${source}\ncheck_line {${check}} {${expect}}")
        if rc != 0 {
            list.add(box, "${check}: the script failed (${tcl.vm_result_str(vm)}) - expected ${expect}: FAIL")
        } else {
            list.add(box, tcl.vm_result_str(vm))
        }
    }
    out, _e = list.get_string(box, 0)
    return out
}

fn run_bridge(g: sandbox.Grants, check: string, expect: string, source: string) -> string {
    token = ghl_map_new()
    ghl_map_put("input", "stunt-in")
    rc = tcl.run_sandboxed_with_map(g, "${source}\naether_map_put line [check_line {${check}} {${expect}}]\n", token)
    line = ghl_map_get("line")
    if rc != 0 || line == "" {
        return "${check}: the script failed (run_sandboxed_with_map returned ${rc}) - expected ${expect}: FAIL"
    }
    return line
}

fn run_row(vm: ptr, g: sandbox.Grants, check: string, expect: string, source: string) -> string {
    if uses_vm(check) == 1 { return run_vm(vm, g, check, expect, source) }
    return run_bridge(g, check, expect, source)
}

fn finish(line: string, before: int, check: string) {
    after = aether_sandbox_depth()
    if after != before {
        println("host: ${check}: the bridge left ${after - before} level(s) in force")
        exit(1)
    }
    println(line)
    exit(policy.verdict(line))
}

fn run_inproc(spec: string, check: string, expect: string) {
    source = "${policy.facts()}${policy.checks_source()}"
    // The shared interpreter (for run_sandboxed_with_map) and the VM both read
    // Tcl's library as they are made: before any sandbox.
    if tcl.init() != 0 {
        println("host: cannot start Tcl (AETHER_TCL_SONAME)")
        exit(1)
    }
    vm = null
    if uses_vm(check) == 1 { vm = make_vm() }
    bar = string.index_of(spec, "|")
    if bar < 0 {
        before = aether_sandbox_depth()
        finish(run_row(vm, policy.grants(spec), check, expect, source), before, check)
        return
    }
    outer = policy.grants(string.substring(spec, 0, bar))
    inner = policy.grants(string.substring(spec, bar + 1, string.length(spec)))
    sandbox.enforce(outer) callback {
        if aether_sandbox_depth() != 1 {
            println("host: the enforce block is not one level deep")
            exit(1)
        }
        before = aether_sandbox_depth()
        finish(run_row(vm, inner, check, expect, source), before, check)
    }
}

main() {
    if os.args_count() != 5 {
        println("usage: host inproc <policy> <check> <expectation>")
        exit(2)
    }
    mode = os.args_get(1)
    if mode == "inproc" {
        run_inproc(os.args_get(2), os.args_get(3), os.args_get(4))
    } else {
        println("host: unknown mode ${mode}")
        exit(2)
    }
}
