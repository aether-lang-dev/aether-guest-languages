// The bridge's two-way tier (#904) through `import tcl`, as a program uses
// it. In aether this was a C harness (tests/integration/
// host_tcl_bidirectional); here the callbacks are Aether @c_callback
// functions, so module.ae's externs and the @source build are covered too.
// The same cases and the same assertions; test_support.c holds what Aether
// cannot say directly (a VM used from another thread, the resident size).
//
// Skips, as test_host_tcl.ae does, when libtcl cannot be loaded. Asserts on
// return codes and on values read back from Tcl, never on the interpreter's
// stdout.

@source("test_support.c")

import tcl
import std.spec
import std.string
import std.list

extern ghl_t_eval_on_other_thread(vm: ptr) -> string
extern ghl_t_rss_kb() -> long
extern ghl_t_i64_max() -> long
extern ghl_t_i64_min() -> long
extern ghl_t_overlong_nul() -> string

@c_callback
cb_add(vm: ptr) -> int {
    tcl.push_int(vm, tcl.arg_int(vm, 1) + tcl.arg_int(vm, 2))
    return 1
}

@c_callback
cb_echo_str(vm: ptr) -> int {
    tcl.push_str(vm, tcl.arg_str(vm, 1))
    return 1
}

@c_callback
cb_bool(vm: ptr) -> int {
    tcl.push_bool(vm, tcl.arg_bool(vm, 1))
    return 1
}

@c_callback
cb_nil(vm: ptr) -> int {
    tcl.push_nil(vm)
    return 1
}

@c_callback
cb_double(vm: ptr) -> int {
    tcl.push_double(vm, tcl.arg_double(vm, 1) * 2.0)
    return 1
}

// Pushes, then returns 0: the command returns nothing.
@c_callback
cb_nothing(vm: ptr) -> int {
    tcl.push_int(vm, 99)
    return 0
}

@c_callback
cb_raise(vm: ptr) -> int {
    return tcl.raise_error(vm, tcl.arg_str(vm, 1))
}

// Notes that it ran (a global the script can read), to show a refused call
// never reached the host.
@c_callback
cb_flag(vm: ptr) -> int {
    tcl.vm_set_global_int(vm, "CALLED", 1)
    return 0
}

// Hands the script a string with Tcl's spelling of NUL in it (C0 80).
@c_callback
cb_overlong(vm: ptr) -> int {
    tcl.push_str(vm, ghl_t_overlong_nul())
    return 1
}

@c_callback
cb_raise_overlong(vm: ptr) -> int {
    return tcl.raise_error(vm, ghl_t_overlong_nul())
}

// The byte length of its string argument (a NUL counts).
@c_callback
cb_arg_len(vm: ptr) -> int {
    tcl.push_int(vm, string.length(tcl.arg_str(vm, 1)))
    return 1
}

// A string with a NUL in it, from the host.
@c_callback
cb_give_nul(vm: ptr) -> int {
    tcl.push_str(vm, "a\0b")
    return 1
}

// An error with a NUL in its message, raised by the host.
@c_callback
cb_raise_nul(vm: ptr) -> int {
    return tcl.raise_error(vm, "bad\0msg")
}

// A string's bytes as decimal numbers, "97 0 98": what a comparison that stops
// at a NUL cannot say.
fn bytes_of(s: string) -> string {
    out = ""
    n = string.length(s)
    i = 0
    while i < n {
        if i > 0 { out = "${out} " }
        out = "${out}${string.char_at(s, i)}"
        i = i + 1
    }
    return out
}

// Each argument's type tag, as a string of digits.
@c_callback
cb_types(vm: ptr) -> int {
    out = ""
    n = tcl.arg_count(vm)
    i = 1
    while i <= n {
        out = "${out}${tcl.arg_type(vm, i)}"
        i = i + 1
    }
    tcl.push_str(vm, out)
    return 1
}

// Evaluates on its own VM in the middle of the script's call, then reads its
// own argument again: the nested call must leave it intact. Pushes arg1 *
// 1000 + the nested result + the level the nested eval ran at, times 100.
@c_callback
cb_nested(vm: ptr) -> int {
    before = tcl.arg_int(vm, 1)
    long inner = -1
    long level = -1
    if tcl.vm_eval(vm, "app.math.add 20 3") == 0 { inner = tcl.vm_result_int(vm) }
    tcl.vm_pop_result(vm)
    if tcl.vm_eval(vm, "info level") == 0 { level = tcl.vm_result_int(vm) }
    tcl.vm_pop_result(vm)
    after = tcl.arg_int(vm, 1)
    if after != before { return tcl.raise_error(vm, "argument clobbered by the nested call") }
    tcl.push_int(vm, after * 1000 + inner + level * 100)
    return 1
}

// Tcl turns `return` and a stray `break` into success and error only at the
// outermost level; nested in a callback the bridge has to. Pushes
// "<rc>:<result>/<rc>:<type>/<rc>:<type>/<rc>:<type>".
@c_callback
cb_nested_codes(vm: ptr) -> int {
    rc1 = tcl.vm_eval(vm, "return 5")
    v = tcl.vm_result_int(vm)
    tcl.vm_pop_result(vm)
    rc2 = tcl.vm_eval(vm, "break")
    t2 = tcl.vm_result_type(vm)
    tcl.vm_pop_result(vm)
    rc3 = tcl.vm_eval(vm, "return -code error nope")
    t3 = tcl.vm_result_type(vm)
    tcl.vm_pop_result(vm)
    rc4 = tcl.vm_eval(vm, "return -level 2 up")
    t4 = tcl.vm_result_type(vm)
    tcl.vm_pop_result(vm)
    tcl.push_str(vm, "${rc1}:${v}/${rc2}:${t2}/${rc3}:${t3}/${rc4}:${t4}")
    return 1
}

// A small nested eval, for the limit cases.
@c_callback
cb_nest_small(vm: ptr) -> int {
    tcl.vm_eval(vm, "set ::ticks [expr {[info exists ::ticks] ? $::ticks + 1 : 1}]")
    tcl.vm_pop_result(vm)
    return 0
}

// Runs `code` and holds its result for the reads that follow.
fn ev(vm: ptr, code: string) -> int {
    tcl.vm_pop_result(vm)
    return tcl.vm_eval(vm, code)
}

fn churn(vm: ptr, rounds: int) {
    i = 0
    while i < rounds {
        tcl.vm_set_global_str(vm, "CHURN", "a string long enough to show if each round keeps one")
        tcl.vm_eval(vm, "host.echo_str \"$CHURN [app.math.add 1 2]\"")
        _s = tcl.vm_result_str(vm)
        tcl.vm_pop_result(vm)
        tcl.vm_eval(vm, "host.raise boom")
        tcl.vm_pop_result(vm)
        tcl.vm_eval(vm, "list a b [expr {1.5 * 2}]")
        // not popped: the next eval must release it
        i = i + 1
    }
    tcl.vm_pop_result(vm)
}

main() {
    fw = spec.init()

    have_tcl = 0
    if tcl.init() == 0 { have_tcl = 1 }
    reason = "libtcl not loadable (set AETHER_TCL_SONAME)"

    vm = null
    if have_tcl == 1 {
        vm = tcl.vm_new()
        tcl.vm_register(vm, "app.math.add", cb_add)
        tcl.vm_register(vm, "host.echo_str", cb_echo_str)
        tcl.vm_register(vm, "host.bool", cb_bool)
        tcl.vm_register(vm, "host.nil", cb_nil)
        tcl.vm_register(vm, "host.double", cb_double)
        tcl.vm_register(vm, "host.nothing", cb_nothing)
        tcl.vm_register(vm, "host.raise", cb_raise)
        tcl.vm_register(vm, "host.types", cb_types)
        tcl.vm_register(vm, "host.nested", cb_nested)
        tcl.vm_register(vm, "host.nest_small", cb_nest_small)
        tcl.vm_register(vm, "ns::inner::add", cb_add)
        tcl.vm_register(vm, "host.nested_codes", cb_nested_codes)
        tcl.vm_register(vm, "host.flag", cb_flag)
        tcl.vm_register(vm, "host.overlong", cb_overlong)
        tcl.vm_register(vm, "host.raise_overlong", cb_raise_overlong)
        tcl.vm_register(vm, "host.arg_len", cb_arg_len)
        tcl.vm_register(vm, "host.give_nul", cb_give_nul)
        tcl.vm_register(vm, "host.raise_nul", cb_raise_nul)
    }

    spec.describe(fw, "tcl vm (#904)") {
        spec.it_when(have_tcl, "callbacks, globals, state kept between evals, namespaced commands", reason) callback {
            tcl.vm_set_global_str(vm, "GSTR", "héllo €")
            tcl.vm_set_global_int(vm, "GINT", 100)
            keys = list.new()
            list.add(keys, "k1")
            list.add(keys, "k 2")
            tcl.vm_set_global_strlist(vm, "KEYS", keys)
            list.free(keys)

            spec.assert_eq(ev(vm, "set x [expr {[app.math.add 2 3] + $GINT}]"), 0, "eval 1")
            spec.assert_eq(tcl.vm_result_type(vm), tcl.TCL_TINT, "an expr result is an int")
            spec.assert_eq_long(tcl.vm_result_int(vm), 105, "callback plus global")
            spec.assert_eq(ev(vm, "expr {$x + 5}"), 0, "state kept")
            spec.assert_eq_long(tcl.vm_result_int(vm), 110, "x kept between evals")
            spec.assert_eq(ev(vm, "ns::inner::add 4 5"), 0, "a namespaced command")
            spec.assert_eq_long(tcl.vm_result_int(vm), 9, "ns::inner::add")
            ev(vm, "expr {[llength $KEYS] == 2 && [lindex $KEYS 1] eq {k 2}}")
            spec.assert_eq(tcl.vm_result_bool(vm), 1, "the string list global is a Tcl list")
            tcl.vm_pop_result(vm)
        }

        // Tcl keeps NUL as the two bytes C0 80 and, in an 8.x built with 16-bit
        // characters, a character beyond the BMP as a surrogate pair of three
        // bytes each: neither is UTF-8. Every string that crosses is converted,
        // a NUL is refused (a Tcl error to the script, an error result to the
        // host, never a changed string), a character beyond the BMP is carried.
        spec.it_when(have_tcl, "a character beyond the BMP crosses both ways, as UTF-8", reason) callback {
            tcl.vm_set_global_str(vm, "EMOJI", "a😀b 𝒳")
            ev(vm, "host.echo_str $EMOJI")
            spec.assert_str_eq(tcl.vm_result_str(vm), "a😀b 𝒳", "a global, through a callback and back")
            ev(vm, "set EMOJI")
            spec.assert_str_eq(tcl.vm_result_str(vm), "a😀b 𝒳", "a global, as the result")
            ev(vm, "set _x \"x😀y\"")
            spec.assert_str_eq(tcl.vm_result_str(vm), "x😀y", "a script that has one in its text")
            ev(vm, "string length \"a😀b\"")
            spec.assert_true(tcl.vm_result_int(vm) == 3 || tcl.vm_result_int(vm) == 4, "it is one character, or two halves on a 16-bit Tcl")
            tcl.vm_pop_result(vm)
        }

        // Tcl keeps NUL as the two bytes C0 80; the bridge converts by length, so
        // a NUL is the byte 00 on the host's side and a character of the string
        // on Tcl's, at every place a string crosses. (From 2026-11-21 until
        // 2026-11-22 these were refused: c753e03.)
        spec.it_when(have_tcl, "a NUL crosses, both ways, at every string crossing", reason) callback {
            // guest to host: a result, a callback's argument, a list element
            spec.assert_eq(ev(vm, "format a%cb 0"), 0, "a result with a NUL is a result")
            spec.assert_eq(tcl.vm_result_type(vm), tcl.TCL_TSTR, "a string")
            spec.assert_str_eq(bytes_of(tcl.vm_result_str(vm)), "97 0 98", "vm_result_str keeps the NUL and what follows it")
            ev(vm, "host.arg_len [format a%cb%c 0 0]")
            spec.assert_eq_long(tcl.vm_result_int(vm), 4, "arg_str is four bytes, not one")
            ev(vm, "host.echo_str [format a%cb 0]")
            spec.assert_str_eq(bytes_of(tcl.vm_result_str(vm)), "97 0 98", "arg_str into push_str and back")
            ev(vm, "host.echo_str [list x [format a%cb 0]]")
            spec.assert_str_eq(bytes_of(tcl.vm_result_str(vm)), "120 32 97 0 98", "a list with a NUL in an element")
            // host to guest: push_str, a global, a list of strings
            ev(vm, "set g [host.give_nul]; list [string length $g] [scan [string index $g 1] %c]")
            spec.assert_str_eq(tcl.vm_result_str(vm), "3 0", "push_str keeps it")
            tcl.vm_set_global_str(vm, "NULSTR", "a\0b\0")
            ev(vm, "list [string length $NULSTR] [scan [string index $NULSTR 1] %c] [scan [string index $NULSTR 2] %c]")
            spec.assert_str_eq(tcl.vm_result_str(vm), "4 0 98", "set_global_str: the script sees all of it, a trailing NUL included")
            items = list.new()
            list.add(items, "p\0q")
            list.add(items, "plain")
            list.add(items, "\0")
            tcl.vm_set_global_strlist(vm, "NULLIST", items)
            list.free(items)
            ev(vm, "set r {}; foreach s $NULLIST { lappend r [string length $s] }; set r")
            spec.assert_str_eq(tcl.vm_result_str(vm), "3 5 1", "set_global_strlist: each keeps its NUL")
            // a NUL and a character beyond the BMP in one string
            ev(vm, "host.echo_str \"x\0😀\0y\"")
            spec.assert_str_eq(bytes_of(tcl.vm_result_str(vm)), "120 0 240 159 152 128 0 121", "both, as UTF-8")
            tcl.vm_pop_result(vm)
        }

        spec.it_when(have_tcl, "an error message keeps its NUL, in the script's error and the host's", reason) callback {
            spec.assert_eq(ev(vm, "error [format x%cy 0]"), -1, "a script error")
            spec.assert_str_eq(bytes_of(tcl.vm_result_str(vm)), "120 0 121", "x NUL y, whole")
            spec.assert_eq(tcl.vm_result_type(vm), tcl.TCL_TERR, "an error")
            ev(vm, "catch {host.raise_nul} m; list [string length $m] [scan [string index $m 3] %c]")
            spec.assert_str_eq(tcl.vm_result_str(vm), "7 0", "raise_error's message reaches the script, NUL and all")
            spec.assert_eq(ev(vm, "host.raise_nul"), -1, "uncaught")
            spec.assert_str_eq(bytes_of(tcl.vm_result_str(vm)), "98 97 100 0 109 115 103", "the host reads it whole")
            spec.assert_eq(ev(vm, "expr 1 + 1"), 0, "and the VM runs on")
            tcl.vm_pop_result(vm)
        }

        // A NUL is a character of Tcl script text, in a word or in a name, and the
        // name of a global or a command is the whole of what the host gave.
        spec.it_when(have_tcl, "script text and names carry a NUL too", reason) callback {
            spec.assert_eq(ev(vm, "set NS \"p\0q\"; string length $NS"), 0, "a raw NUL inside a quoted word")
            spec.assert_eq_long(tcl.vm_result_int(vm), 3, "is a character of the word")
            spec.assert_eq(ev(vm, "set X1 1;\0set X2 2"), -1, "a raw NUL where a command starts joins the word after it")
            spec.assert_str_eq(bytes_of(tcl.vm_result_str(vm)), "105 110 118 97 108 105 100 32 99 111 109 109 97 110 100 32 110 97 109 101 32 34 0 115 101 116 34", "an invalid command name, named whole")
            ev(vm, "info exists X1")
            spec.assert_eq_long(tcl.vm_result_int(vm), 1, "and what came before it ran")
            ev(vm, "info exists X2")
            spec.assert_eq_long(tcl.vm_result_int(vm), 0, "and what came after did not")
            tcl.vm_set_global_str(vm, "AB\0CD", "v")
            tcl.vm_set_global_int(vm, "AB\0CI", 7)
            items = list.new()
            list.add(items, "x")
            tcl.vm_set_global_strlist(vm, "AB\0CL", items)
            list.free(items)
            ev(vm, "list [set [format AB%cCD 0]] [set [format AB%cCI 0]] [lindex [set [format AB%cCL 0]] 0] [info exists AB]")
            spec.assert_str_eq(tcl.vm_result_str(vm), "v 7 x 0", "each under its whole name, none under the part before the NUL")
            spec.assert_eq(tcl.vm_register(vm, "ab\0cd", cb_add), 0, "a command's name")
            spec.assert_eq(tcl.vm_register(vm, "nq\0s::add", cb_add), 0, "a namespaced name with a NUL in a part")
            ev(vm, "list [[format ab%ccd 0] 2 3] [[format nq%cs::add 0] 4 5] [info commands ab]")
            spec.assert_str_eq(tcl.vm_result_str(vm), "5 9 {}", "both called under their whole names, neither under the part before the NUL")
            spec.assert_eq(ev(vm, "ab\0cd 6 7"), 0, "and called by a raw NUL in the script text")
            spec.assert_eq_long(tcl.vm_result_int(vm), 13, "the same command")
            tcl.vm_pop_result(vm)
        }

        // What cannot cross is refused, with the reason, and nothing is changed
        // on the way: a lone surrogate (UTF-8 has no spelling for one) and, from
        // the host, the overlong NUL C0 80 (not UTF-8; it would read back as a
        // NUL).
        spec.it_when(have_tcl, "what UTF-8 cannot spell is refused, in every place a string crosses", reason) callback {
            tcl.vm_set_global_int(vm, "CALLED", 0)
            // the script makes a lone surrogate (`format %c 55296`): Tcl 8 keeps it,
            // and Tcl 9 may already have turned it into U+FFFD
            rc = ev(vm, "format a%cb 55296")
            if rc == -1 {
                spec.assert_true(string.contains(tcl.vm_result_str(vm), "the script's result: refused: it holds an unpaired surrogate") == 1, "a result with a lone surrogate is refused, and says why")
            } else {
                spec.assert_str_eq(bytes_of(tcl.vm_result_str(vm)), "97 239 191 189 98", "this Tcl made it U+FFFD, which is UTF-8")
            }
            rc = ev(vm, "host.flag [format a%cb 55296]")
            if rc == -1 {
                spec.assert_true(string.contains(tcl.vm_result_str(vm), "host.flag: argument 1: refused: it holds an unpaired surrogate") == 1, "a callback argument with one: refused, naming the command")
                ev(vm, "expr {[info exists CALLED] ? $CALLED : -1}")
                spec.assert_eq_long(tcl.vm_result_int(vm), 0, "the host function was never called")
            }
            // host to guest: C0 80, the one spelling of NUL a string can hold that is not a NUL
            spec.assert_eq(ev(vm, "catch {host.overlong} m; set m"), 0, "a callback's string with C0 80")
            spec.assert_true(string.contains(tcl.vm_result_str(vm), "the value the host returned: refused: it holds the overlong NUL C0 80") == 1, "is refused in the script")
            spec.assert_eq(ev(vm, "catch {host.raise_overlong} m; set m"), 0, "an error message with C0 80")
            spec.assert_true(string.contains(tcl.vm_result_str(vm), "the error message the host raised: refused") == 1, "is refused too")
            tcl.vm_set_global_str(vm, "BAD", ghl_t_overlong_nul())
            spec.assert_eq(ev(vm, "expr 1"), -1, "a global set from a string with C0 80: the next eval does not run")
            spec.assert_true(string.contains(tcl.vm_result_str(vm), "tcl_vm_set_global_str(BAD): the value: refused") == 1, "and names the global")
            spec.assert_eq(ev(vm, "info exists BAD"), 0, "the eval after that runs")
            spec.assert_eq_long(tcl.vm_result_int(vm), 0, "and the global was not set")
            spec.assert_eq(ev(vm, ghl_t_overlong_nul()), -1, "a script with C0 80 in it")
            spec.assert_true(string.contains(tcl.vm_result_str(vm), "the script: refused") == 1, "is refused")
            spec.assert_eq(tcl.vm_register(vm, ghl_t_overlong_nul(), cb_add), -1, "a command named with C0 80")
            // everything else still crosses
            spec.assert_eq(ev(vm, "host.echo_str ok"), 0, "afterwards")
            spec.assert_str_eq(tcl.vm_result_str(vm), "ok", "everything else crosses")
            tcl.vm_pop_result(vm)
        }

        spec.it_when(have_tcl, "typed results", reason) callback {
            tcl.vm_set_global_str(vm, "GSTR", "héllo €")
            ev(vm, "host.echo_str $GSTR")
            spec.assert_eq(tcl.vm_result_type(vm), tcl.TCL_TSTR, "a string")
            spec.assert_str_eq(tcl.vm_result_str(vm), "héllo €", "non-ASCII string")
            ev(vm, "host.double 1.25")
            spec.assert_eq(tcl.vm_result_type(vm), tcl.TCL_TFLOAT, "a double")
            spec.assert_true(tcl.vm_result_double(vm) == 2.5, "reads as 2.5")
            ev(vm, "host.bool yes")
            spec.assert_eq(tcl.vm_result_bool(vm), 1, "bool pushes 1")
            spec.assert_eq_long(tcl.vm_result_int(vm), 1, "and reads as 1")
            ev(vm, "host.nil")
            spec.assert_eq(tcl.vm_result_type(vm), tcl.TCL_TNIL, "nil is the empty value")
            spec.assert_str_eq(tcl.vm_result_str(vm), "", "an empty string")
            ev(vm, "host.nothing")
            spec.assert_eq(tcl.vm_result_type(vm), tcl.TCL_TNIL, "a callback returning 0 returns nothing, whatever it pushed")
            ev(vm, "list a b")
            spec.assert_eq(tcl.vm_result_type(vm), tcl.TCL_TTABLE, "a list")
            spec.assert_str_eq(tcl.vm_result_str(vm), "a b", "and its string")
            ev(vm, "expr {2**70}")
            spec.assert_eq(tcl.vm_result_type(vm), tcl.TCL_TOTHER, "a bignum")
            spec.assert_eq_long(tcl.vm_result_int(vm), ghl_t_i64_max(), "saturates")
            ev(vm, "expr {-(2**70)}")
            spec.assert_eq_long(tcl.vm_result_int(vm), ghl_t_i64_min(), "negative bignum saturates")
            spec.assert_eq(ev(vm, "return 7"), 0, "a top-level return")
            spec.assert_eq_long(tcl.vm_result_int(vm), 7, "is a result")
            spec.assert_eq(ev(vm, "return -code error top"), -1, "a top-level return -code error")
            spec.assert_eq(tcl.vm_result_type(vm), tcl.TCL_TERR, "is an error")
            spec.assert_eq(ev(vm, "return -level 2 up"), -1, "a top-level return -level 2")
            spec.assert_true(string.contains(tcl.vm_result_str(vm), "bad code") == 1, "is a bad code")
            ev(vm, "host.types [expr {5}] [expr {2.5}] [list a b] {} hello")
            spec.assert_str_eq(tcl.vm_result_str(vm), "27403", "argument types")
            tcl.vm_pop_result(vm)
        }

        spec.it_when(have_tcl, "errors", reason) callback {
            spec.assert_eq(ev(vm, "catch {host.raise deliberate} m; set m"), 0, "a raise is catchable")
            spec.assert_str_eq(tcl.vm_result_str(vm), "deliberate", "the caught message")
            spec.assert_eq(ev(vm, "host.raise uncaught"), -1, "an uncaught raise fails the eval")
            spec.assert_eq(tcl.vm_result_type(vm), tcl.TCL_TERR, "and reads as an error")
            spec.assert_str_eq(tcl.vm_result_str(vm), "uncaught", "with its message")
            spec.assert_eq(ev(vm, "break"), -1, "break outside a loop is an error")
            spec.assert_eq(tcl.vm_result_type(vm), tcl.TCL_TERR, "and reads as one")
            spec.assert_eq(ev(vm, "expr {1 +}"), -1, "a syntax error")
            spec.assert_eq(tcl.vm_result_type(vm), tcl.TCL_TERR, "reads as an error")
            spec.assert_eq(ev(vm, "expr {6 * 7}"), 0, "an eval after errors succeeds")
            spec.assert_eq(tcl.vm_result_type(vm), tcl.TCL_TINT, "an int")
            spec.assert_eq_long(tcl.vm_result_int(vm), 42, "42")
            tcl.vm_pop_result(vm)
        }

        spec.it_when(have_tcl, "a nested eval runs at global level and leaves the callback's arguments intact", reason) callback {
            spec.assert_eq(ev(vm, "proc p {} { host.nested 7 }; p"), 0, "nested eval")
            spec.assert_eq_long(tcl.vm_result_int(vm), 7023, "7 * 1000 + 23 + level 0")
            ev(vm, "host.nested_codes")
            spec.assert_str_eq(tcl.vm_result_str(vm), "0:5/-1:5/-1:5/-1:5", "a nested return and break")
            tcl.vm_pop_result(vm)
        }

        // The command limit stops a loop of commands, cannot be caught, is
        // per outermost eval, and a nested eval does not renew it. The time
        // limit is the only one that stops a loop of no commands.
        spec.it_when(have_tcl, "the command limit and the time limit", reason) callback {
            spec.assert_str_eq(tcl.vm_set_instruction_limit(vm, 2000, 1), "", "set the command limit")
            spec.assert_eq(ev(vm, "while 1 {incr i}"), -1, "a command loop is stopped")
            spec.assert_true(string.contains(tcl.vm_result_str(vm), "command count limit") == 1, "by the command limit")
            spec.assert_eq(ev(vm, "catch {while 1 {incr i}}; set survived 1"), -1, "the command limit cannot be caught")
            round = 0
            while round < 4 {
                spec.assert_eq(ev(vm, "for {set j 0} {$j < 300} {incr j} {incr k}"), 0, "each round is within the budget")
                round = round + 1
            }
            spec.assert_eq(ev(vm, "while 1 {host.nest_small}"), -1, "a nested eval does not renew the budget")
            tcl.vm_set_instruction_limit(vm, 0, 1)

            spec.assert_str_eq(tcl.vm_set_time_limit(vm, 300, 1), "", "set the time limit")
            spec.assert_eq(ev(vm, "while 1 {}"), -1, "a loop of no commands is stopped")
            spec.assert_true(string.contains(tcl.vm_result_str(vm), "time limit") == 1, "by the time limit")
            tcl.vm_set_time_limit(vm, 0, 1)
            spec.assert_eq(ev(vm, "after 400; expr 1"), 0, "the time limit is removed")
            tcl.vm_pop_result(vm)
        }

        spec.it_when(have_tcl, "another thread is refused, and the VM works afterwards on its own", reason) callback {
            spec.assert_str_eq(ghl_t_eval_on_other_thread(vm), "-1|5|tcl vm used from a thread other than the one that created it", "refused without touching Tcl")
            spec.assert_eq(ev(vm, "expr {1 + 1}"), 0, "own thread after a refusal")
            spec.assert_eq_long(tcl.vm_result_int(vm), 2, "2")
            tcl.vm_pop_result(vm)
        }

        spec.it_when(have_tcl, "two VMs share nothing", reason) callback {
            vm2 = tcl.vm_new()
            spec.assert_not_null(vm2, "a second VM")
            tcl.vm_set_global_int(vm, "GINT", 100)
            spec.assert_eq(tcl.vm_eval(vm2, "list [info exists GINT] [llength [info commands app.math.add]]"), 0, "eval on the second")
            spec.assert_str_eq(tcl.vm_result_str(vm2), "0 0", "no global and no command of the first")
            tcl.vm_pop_result(vm2)
            tcl.vm_free(vm2)
        }

        // Two loops, the smaller growth bounded. A reference kept per round
        // grows a loop by several hundred kilobytes.
        spec.it_when(have_tcl, "memory stays flat over many rounds", reason) callback {
            churn(vm, 20000)
            a = ghl_t_rss_kb()
            churn(vm, 20000)
            b = ghl_t_rss_kb()
            churn(vm, 20000)
            c = ghl_t_rss_kb()
            g1 = b - a
            g2 = c - b
            g = g1
            if g2 < g1 { g = g2 }
            spec.assert_true(g < 128, "memory flat over 20000 rounds (${g1} kB, then ${g2} kB)")
        }
    }

    _rc = spec.run_summary(fw)

    if have_tcl == 1 {
        tcl.vm_free(vm)
        tcl.finalize()
    }
    return _rc
}
