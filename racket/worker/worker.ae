// racket-worker: Racket CS in a contained child, the guest's side of
// std.guest.
//
// A host starts this with guest.launch (sandbox.spawn_socket: Landlock and
// seccomp on Linux; refused on macOS and Windows, where nothing starts) and
// sends it the functions it may call (MOUNT) and a Racket program (SCRIPT).
// The worker loads Racket CS's library and boots it before it locks itself
// down, requires the libraries the script may use, then runs the script in
// the bridge's VM inside std.guest.child's lockdown:
//
//   display, displayln, write, printf ...
//                       SAY, one per line of output (and one for what is
//                       left when the script ends)
//   (host-NAME args ...)
//                       for each mounted NAME: CALL NAME [args as JSON], the
//                       host's answer decoded back to Racket (a granted file
//                       is a hash with 'granted and 'text); a FAIL raises an
//                       exception with the message; a CANCEL raises
//                       "cancelled by host: ..." (NAME with _ as -, so
//                       aether_map_get is aether-map-get, and read_file is
//                       host-read-file; the two map calls are not prefixed)
//   the end             DONE 0, or ERROR and the exception's message
//
// Usage (by a host): racket-worker <library> <boot dir> <collects> <config>
//
// guest.launch gives the worker no environment, so the host names what the
// bridge would read from it (AETHER_RACKET_SONAME, _BOOT_DIR, _COLLECTS,
// _CONFIG) as arguments. Racket reads a module from disk the first time it is
// required; once the worker has locked itself down it can read nothing, so a
// library the script uses that is not required by then fails. The worker
// requires racket (the bridge's boot does), ffi/unsafe, racket/tcp,
// racket/system, racket/port, racket/string and json.
//
// A CANCEL is looked for in every call's reply, and only there: Racket CS's
// embedded scheduler does not reliably run a thread beside a script that
// computes (racket/README.md, "Stopping a run"), so there is no cancel hook
// like the other workers'. A script that never calls a host function never
// sees one, and the host kills it after its grace period: the containment is
// the host's.

import racket
import std.guest.child
import std.os
import std.string

extern exit(code: int)
extern setenv(name: string, value: string, overwrite: int) -> int
extern ghl_keep(p: ptr)
extern ghl_kept() -> ptr

@source("worker_support.c")

// The Host the callbacks below answer through (one per process).
fn host() -> *child.Host {
    return ghl_kept() as *child.Host
}

// __say(text)
@c_callback
w_say(vm: ptr) -> int {
    child.say(host(), racket.arg_str(vm, 1))
    return 0
}

// __call(name, args_json) -> "KIND\ntext"
@c_callback
w_call(vm: ptr) -> int {
    r = child.call_host(host(), racket.arg_str(vm, 1), racket.arg_str(vm, 2))
    racket.push_str(vm, "${r.kind}\n${r.text}")
    return 1
}

// The glue between Racket and the protocol, run before the script.
fn prelude() -> string {
    return <<RKT
(require ffi/unsafe racket/tcp racket/system racket/port racket/string json)

;; Output: one SAY per line, and the rest when flushed (the end of the script).
(define aether-pending (open-output-bytes))
(define (aether-emit-lines!)
  (let* ([all (get-output-bytes aether-pending #t)]
         [parts (regexp-split #rx#"\n" all)])
    (for-each (lambda (p) (__say (bytes->string/utf-8 p #\?))) (reverse (cdr (reverse parts))))
    (write-bytes (car (reverse parts)) aether-pending)))
(define aether-out
  (make-output-port 'aether always-evt
    (lambda (bs start end non-block? breakable?)
      (cond [(= start end)
             (aether-emit-lines!)
             (let ([rest (get-output-bytes aether-pending #t)])
               (unless (zero? (bytes-length rest)) (__say (bytes->string/utf-8 rest #\?))))]
            [else
             (write-bytes bs aether-pending start end)
             (aether-emit-lines!)])
      (- end start))
    void))
(current-output-port aether-out)

;; Host functions: CALL NAME [args as JSON]; the answer's KIND is VALUE, FAIL or CANCEL.
(define (aether-answer name json)
  (let* ([r (__call name json)]
         [nl (let loop ([i 0]) (if (char=? (string-ref r i) #\newline) i (loop (add1 i))))]
         [kind (substring r 0 nl)]
         [text (substring r (add1 nl))])
    (cond [(equal? kind "VALUE") (string->jsexpr text)]
          [(equal? kind "CANCEL")
           (set-box! aether-cancelled-box text)
           (raise (exn:fail (string-append "cancelled by host: " text) (current-continuation-marks)))]
          [else (raise (exn:fail text (current-continuation-marks)))])))
(define (aether-mount! name)
  (let ([proc (lambda args (aether-answer name (jsexpr->string args)))]
        [dashed (string-replace name "_" "-")])
    (namespace-set-variable-value!
     (string->symbol (if (regexp-match? #rx"^aether_map_" name) dashed (string-append "host-" dashed)))
     proc)))
(for-each aether-mount! __MOUNTS)

RKT
}

// The mounted names, as a Racket list literal.
fn mounts_rkt(h: *child.Host) -> string {
    out = "(define __MOUNTS (list"
    n = child.mount_count(h)
    i = 0
    while i < n {
        name, _min, _max = child.mount_at(h, i)
        out = "${out} \"${name}\""
        i = i + 1
    }
    return "${out}))\n"
}

main() {
    h, err = child.open("racket-worker")
    if err != "" {
        println(err)
        exit(2)
    }
    if child.read_script(h) != "" { exit(1) }
    // The library is loaded and Racket booted here, before the lockdown:
    // afterwards the worker opens nothing.
    if os.args_count() > 4 {
        setenv("AETHER_RACKET_SONAME", os.args_get(1), 1)
        setenv("AETHER_RACKET_BOOT_DIR", os.args_get(2), 1)
        setenv("AETHER_RACKET_COLLECTS", os.args_get(3), 1)
        setenv("AETHER_RACKET_CONFIG", os.args_get(4), 1)
    }
    if racket.init() != 0 {
        child.error(h, "racket-worker: cannot boot Racket CS (AETHER_RACKET_SONAME)")
        exit(1)
    }
    ghl_keep(h as ptr)
    racket.register("__say", w_say)
    racket.register("__call", w_call)
    if racket.run("${mounts_rkt(h)}${prelude()}") != 0 {
        child.error(h, "racket-worker: the prelude failed: ${racket.last_error()}")
        exit(1)
    }
    child.run(h) callback {
        if racket.run(h.source) == 0 {
            child.done(h, 0)
        } else {
            child.error(h, racket.last_error())
        }
    }
    exit(0)
}
