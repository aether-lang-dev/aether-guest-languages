// The host the containment tests drive (tests/test_stunt_*.sh). Usage:
//
//   host inproc <policy> <check> <expectation>
//
// Runs one row of stunt's catalogue (aether contrib/host/stunt), written in
// Racket (checks.rkt beside this, or $RACKET_CHECKS), in the Racket bridge in
// this process, under the policy's grants, and prints stunt's line for it:
//
//   <check>: <outcome> (<detail>) - expected <expectation>: PASS|FAIL
//
// exiting 0 when it matched. Run it under libaether_sandbox.so (LD_PRELOAD)
// for Racket's own libc calls (open-input-file, connect, the shell, ffi-lib)
// to be checked: in-process, nothing else sees them.
//
// Every row goes through racket.run_sandboxed_with_map, the bridge's own
// sandboxed run: the line comes back through the map, as an output the
// script writes. The host functions the rows call (host-read-file,
// host-getenv, host-greet, host-add) are registered with racket.register
// first; read_file and getenv check the grants themselves, as stunt's host
// does, and refuse by raising an exception ("refused: ..."). spin is left
// out (tests/stunt_lib.sh does not call it): nothing stops an endless
// evaluation (racket/README.md, "Stopping a run").
//
// Before any of it, the libraries checks.rkt uses are required with no
// sandbox in force, as a host does for a program it lends them to: under a
// policy with no read grant on the collects directory, a library that is not
// required yet cannot be (racket/README.md).
//
// <policy> is "-" for no grants, or kind=pattern,... with kinds fs_read,
// fs_write, exec, env, tcp (host:port), native, fork. "<outer>|<inner>"
// runs the check inside sandbox.enforce(<outer>), so the bridge's level
// nests in the block's. The policy grammar is in policy/module.ae; the
// contained child's host is child_host.ae.

@source("host_support.c")

import racket
import policy
import std.sandbox
import std.os
import std.fs
import std.list
import std.string

extern exit(code: int)
extern aether_sandbox_depth() -> int
// 1 when every level in force grants it (runtime/aether_sandbox.h).
extern aether_sandbox_check_slow(category: string, resource: string) -> int
extern ghl_map_new() -> long
extern ghl_map_put(key: string, value: string)
extern ghl_map_get(key: string) -> string

// The libraries checks.rkt uses, required before any sandbox.
const PREREQUIRE = "(require ffi/unsafe racket/tcp racket/system racket/port json)"

// ---- host functions the guest calls ----------------------------------------

// host-read-file(path): the file's text, or an exception "refused: ..." when
// the grants do not allow reading it, or the error.
@c_callback
host_read_file(vm: ptr) -> int {
    path = racket.arg_str(vm, 1)
    if aether_sandbox_check_slow("fs_read", path) == 0 {
        return racket.raise_error(vm, "refused: fs_read ${path}")
    }
    text, err = fs.read(path)
    if err != "" {
        return racket.raise_error(vm, err)
    }
    racket.push_str(vm, text)
    return 1
}

// host-getenv(name): the variable, or an exception "refused: ..." when the
// grants do not allow it, or "<name> is unset".
@c_callback
host_getenv(vm: ptr) -> int {
    name = racket.arg_str(vm, 1)
    if aether_sandbox_check_slow("env", name) == 0 {
        return racket.raise_error(vm, "refused: env ${name}")
    }
    v = os.getenv(name)
    if v == "" {
        return racket.raise_error(vm, "${name} is unset")
    }
    racket.push_str(vm, v)
    return 1
}

@c_callback
host_greet(vm: ptr) -> int {
    racket.push_str(vm, "hello, ${racket.arg_str(vm, 1)}")
    return 1
}

@c_callback
host_add(vm: ptr) -> int {
    if racket.arg_type(vm, 1) != racket.RACKET_TINT || racket.arg_type(vm, 2) != racket.RACKET_TINT {
        return racket.raise_error(vm, "add takes two ints")
    }
    racket.push_int(vm, racket.arg_int(vm, 1) + racket.arg_int(vm, 2))
    return 1
}

// ---- the rows ---------------------------------------------------------------

fn run_row(g: sandbox.Grants, check: string, expect: string, source: string) -> string {
    token = ghl_map_new()
    ghl_map_put("input", "stunt-in")
    rc = racket.run_sandboxed_with_map(g, "${source}\n(aether-map-put \"line\" (check-line \"${check}\" \"${expect}\"))", token)
    line = ghl_map_get("line")
    if rc != 0 || line == "" {
        return "${check}: the script failed (run_sandboxed_with_map returned ${rc}: ${racket.last_error()}) - expected ${expect}: FAIL"
    }
    return line
}

fn finish(line: string, before: int, check: string) {
    after = aether_sandbox_depth()
    if after != before {
        println("host: ${check}: the bridge left ${after - before} level(s) in force")
        exit(1)
    }
    println(line)
    exit(policy.verdict(line))
}

fn run_inproc(spec: string, check: string, expect: string) {
    source = "${policy.facts()}${policy.checks_source()}"
    if racket.init() != 0 {
        println("host: cannot load Racket CS (AETHER_RACKET_SONAME)")
        exit(1)
    }
    if racket.run(PREREQUIRE) != 0 {
        println("host: ${racket.last_error()}")
        exit(1)
    }
    // ffi-lib reads Racket's system.rktd the first time it loads a library by
    // path: once, before the sandbox, as the requires are.
    libm = os.getenv("GHL_LIBM")
    if libm != "" { racket.run("(ffi-lib \"${libm}\")") }
    racket.register("host-read-file", host_read_file)
    racket.register("host-getenv", host_getenv)
    racket.register("host-greet", host_greet)
    racket.register("host-add", host_add)
    bar = string.index_of(spec, "|")
    if bar < 0 {
        before = aether_sandbox_depth()
        finish(run_row(policy.grants(spec), check, expect, source), before, check)
        return
    }
    outer = policy.grants(string.substring(spec, 0, bar))
    inner = policy.grants(string.substring(spec, bar + 1, string.length(spec)))
    sandbox.enforce(outer) callback {
        if aether_sandbox_depth() != 1 {
            println("host: the enforce block is not one level deep")
            exit(1)
        }
        before = aether_sandbox_depth()
        finish(run_row(inner, check, expect, source), before, check)
    }
}


main() {
    if os.args_count() != 5 {
        println("usage: host inproc <policy> <check> <expectation>")
        exit(2)
    }
    mode = os.args_get(1)
    if mode == "inproc" {
        run_inproc(os.args_get(2), os.args_get(3), os.args_get(4))
    } else {
        println("host: unknown mode ${mode}")
        exit(2)
    }
}
