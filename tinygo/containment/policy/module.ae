// policy: what the in-process host (host.ae) and the contained-child host
// (child_host.ae) share: the policy grammar, the facts a row is given, the
// symbol a row is called by, and the judge's verdict. add_grant and grants
// are aether's tests/integration/contrib_host_stunt/host.ae, unchanged; this
// is python/containment/policy/module.ae with the facts as KEY=VALUE pairs
// (a Go check takes them as one string) and no checks source (the checks are
// a library, checks.go).

exports(add_grant, grants, facts, symbol, verdict)

import std.sandbox
import std.os
import std.fs
import std.string

extern exit(code: int)

add_grant(g: sandbox.Grants, item: string) {
    eq = string.index_of(item, "=")
    kind = item
    pat = ""
    if eq >= 0 {
        kind = string.substring(item, 0, eq)
        pat = string.substring(item, eq + 1, string.length(item))
    }
    if kind == "fs_read" { sandbox.grant_fs_read(g, pat) return }
    if kind == "fs_write" { sandbox.grant_fs_write(g, pat) return }
    if kind == "exec" { sandbox.grant_exec(g, pat) return }
    if kind == "env" { sandbox.grant_env(g, pat) return }
    if kind == "native" { sandbox.grant_native(g, pat) return }
    if kind == "fork" { sandbox.grant_fork(g) return }
    if kind == "tcp" {
        host = pat
        port = 0
        colon = string.index_of(pat, ":")
        if colon >= 0 {
            host = string.substring(pat, 0, colon)
            p, perr = string.to_int(string.substring(pat, colon + 1, string.length(pat)))
            if perr == "" { port = p }
        }
        sandbox.grant_tcp(g, host, port)
        return
    }
    println("host: unknown grant kind ${kind}")
    exit(2)
}

grants(spec: string) -> sandbox.Grants {
    g = sandbox.new("tinygo") {
    }
    if spec != "-" && spec != "" {
        items = string.split(spec, ",")
        n = string.array_size(items)
        i = 0
        while i < n {
            add_grant(g, string.array_get(items, i))
            i = i + 1
        }
        string.array_free(items)
    }
    return g
}

// What the host knows before the sandbox is in force, as KEY=VALUE pairs
// separated by ";", the way checks.go reads them: that HOME is in its
// environment (so a missing one is a refusal, not an unset variable), that
// /bin/sh is there, and the libraries the dlopen rows load (GHL_LIBM,
// GHL_LIBC_NAME, GHL_LIBC_PATH: the names stunt's own rows use, set by
// tests/stunt_lib.sh).
facts() -> string {
    f = ""
    if os.getenv("HOME") != "" { f = "${f}HOST_HOME_SET=1;" } else { f = "${f}HOST_HOME_SET=0;" }
    if fs.exists("/bin/sh") == 1 { f = "${f}HOST_SH=1;" } else { f = "${f}HOST_SH=0;" }
    libm = os.getenv("GHL_LIBM")
    if libm != "" { f = "${f}LIBM_PATH=${libm};" }
    libc_name = os.getenv("GHL_LIBC_NAME")
    if libc_name != "" { f = "${f}LIBC_NAME=${libc_name};" }
    libc_path = os.getenv("GHL_LIBC_PATH")
    if libc_path != "" { f = "${f}LIBC_PATH=${libc_path};" }
    return f
}

// The exported symbol that does a row: check_<row>, the row's name with "-"
// and "." made "_" (checks.go).
symbol(check: string) -> string {
    name = string.replace_all(string.replace_all(check, "-", "_"), ".", "_")
    return "check_${name}"
}

// The judge's verdict, from the end of the line.
verdict(line: string) -> int {
    if string.ends_with(line, ": PASS") == 1 { return 0 }
    return 1
}
