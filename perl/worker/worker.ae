// perl-worker: Perl in a contained child, the guest's side of std.guest.
//
// A host starts this with guest.launch (sandbox.spawn_socket: Landlock and
// seccomp on Linux; refused on macOS and Windows, where nothing starts) and
// sends it the functions it may call (MOUNT) and a Perl script (SCRIPT).
// The worker loads libperl and starts the interpreter before it locks
// itself down, loads the modules the host names, then runs the script in the
// bridge's interpreter inside std.guest.child's lockdown:
//
//   print ...           SAY, the arguments joined by $, and $\ added, one
//                       trailing newline dropped (say, printf and print to
//                       STDOUT: STDOUT is tied)
//   NAME(...)           for each mounted NAME: CALL NAME [args as JSON], the
//                       host's answer decoded back to Perl (a granted file
//                       is {granted => true, text => ...}); a FAIL dies with
//                       the message; a CANCEL dies "cancelled by host: ..."
//   export NAME ...     marks subs for the host to call by name once the
//                       script has ended (export NAME => sub {...} gives the
//                       code itself). A script that exported anything ends
//                       with READY and its names instead of DONE, and serves:
//                       each INVOKE calls the sub with its JSON arguments in
//                       the same interpreter (the script's package variables,
//                       lexicals its subs closed over and modules as it left
//                       them), in scalar context, and is answered RETURN and
//                       the value as JSON, or RAISE and the die message, after
//                       which it serves on; END ends it with DONE 0. The names
//                       are fixed at READY. `export` is the worker's: a host
//                       cannot mount it.
//   the end             DONE 0, or ERROR and the script's $@ (with its
//                       "at (eval N) line N." and newline)
//
// Usage (by a host): perl-worker [<libperl soname or path> [<modules>]]
//
// <modules> is a comma list of modules to load before the lockdown (JSON::PP
// and Time::HiRes, which the worker itself uses, always are). Perl reads a
// module from disk the first time it is loaded; once the worker has locked
// itself down it can read nothing, so a module the script needs that is not
// loaded by then fails ("Can't locate ...: Permission denied"). Perl's own
// start (the library path, utf8 tables it loads lazily) happens before the
// lockdown too. A module with an XS half (Socket, POSIX, List::Util) loads
// its shared object at that point as well.
//
// A CANCEL is looked for every 50 ms from a SIGALRM handler (Time::HiRes's
// setitimer; Perl runs a handler between two ops), and in every call's
// reply. A script that removes the handler (or catches the die, which ends
// one run of the handler, not the timer) stops answering, and the host kills
// it after its grace period: the containment is the host's, not the
// handler's.

import perl
import std.guest.child
import std.os
import std.string

extern exit(code: int)
extern setenv(name: string, value: string, overwrite: int) -> int
extern ghl_keep(p: ptr)
extern ghl_kept() -> ptr

@source("worker_support.c")

// What the callbacks answer through (one per process): the Host, and what
// the prelude last handed back with __out (perl.run returns no value).
struct Worker {
    h: *child.Host
    out: string
}

fn worker() -> *Worker {
    return ghl_kept() as *Worker
}

fn host() -> *child.Host {
    return worker().h
}

// __out(text): the prelude's answer to the worker (the export names at
// READY, an invocation's outcome)
@c_callback
w_out(ctx: ptr) -> int {
    worker().out = perl.arg_str(ctx, 1)
    return 0
}

// __args() -> the arguments of the invocation being served, a JSON array
@c_callback
w_args(ctx: ptr) -> int {
    perl.push_str(ctx, host().invoked)
    return 1
}

// __say(text)
@c_callback
w_say(ctx: ptr) -> int {
    child.say(host(), perl.arg_str(ctx, 1))
    return 0
}

// __call(name, args_json) -> "KIND\ntext"
@c_callback
w_call(ctx: ptr) -> int {
    r = child.call_host(host(), perl.arg_str(ctx, 1), perl.arg_str(ctx, 2))
    perl.push_str(ctx, "${r.kind}\n${r.text}")
    return 1
}

// __poll() -> "" or the reason the host cancelled
@c_callback
w_poll(ctx: ptr) -> int {
    perl.push_str(ctx, child.poll(host()))
    return 1
}

// The glue between Perl and the protocol, run before the script.
fn prelude() -> string {
    return <<PL
package _AeOut;
sub TIEHANDLE { bless {}, shift }
sub PRINT {
    my $self = shift;
    my $t = join(defined $, ? $, : '', @_);
    $t .= $\ if defined $\;
    $t =~ s/\n\z//;
    main::__say($t);
    return 1;
}
sub PRINTF {
    my $self = shift;
    my $fmt = shift;
    return PRINT($self, sprintf($fmt, @_));
}
package main;
tie *STDOUT, '_AeOut';

our $_ae_json = JSON::PP->new->allow_nonref->canonical;

sub _ae_mount {
    my $name = shift;
    no strict 'refs';
    no warnings 'redefine';
    *{"main::$name"} = sub {
        my $r = main::__call($name, $main::_ae_json->encode([@_]));
        my ($kind, $text) = split(/\n/, $r, 2);
        $text = '' unless defined $text;
        return $main::_ae_json->decode($text) if $kind eq 'VALUE';
        die "cancelled by host: $text\n" if $kind eq 'CANCEL';
        die "$text\n";
    };
}
_ae_mount($_) for @main::__MOUNTS;

# Not while a call is in flight: its own reply carries a CANCEL.
$SIG{ALRM} = sub {
    return if $main::_ae_busy;
    my $why = main::__poll();
    die "cancelled by host: $why\n" if defined $why && length $why;
};
Time::HiRes::setitimer(Time::HiRes::ITIMER_REAL(), 0.05, 0.05);

# Exports: subs the host may call by name once the script has ended.
our (%_ae_exports, @_ae_order, %_ae_served);
sub export {
    while (@_) {
        my $name = shift;
        my $code;
        if (@_ && ref($_[0]) eq 'CODE') {
            $code = shift;
        } else {
            no strict 'refs';
            $code = \&{"main::$name"} if defined &{"main::$name"};
        }
        die "export: no sub named $name\n" unless $code;
        push @_ae_order, $name unless exists $_ae_exports{$name};
        $_ae_exports{$name} = $code;
    }
    return;
}
# The names at READY, fixed from here on, as a JSON array; '' for none.
sub _ae_ready {
    %_ae_served = %_ae_exports;
    main::__out(@_ae_order ? JSON::PP->new->encode([@_ae_order]) : '');
}
# One INVOKE: "RETURN\n<json>" or "RAISE\n<message>", through __out.
sub _ae_serve {
    my $name = shift;
    my $code = $_ae_served{$name};
    return main::__out("RAISE\nno export named $name") unless $code;
    my $r = eval {
        my @args = @{ $main::_ae_json->decode(main::__args()) };
        my $v = $code->(@args);
        "RETURN\n" . $main::_ae_json->encode($v);
    };
    unless (defined $r) {
        my $e = $@;
        $e =~ s/\n\z//;
        $r = "RAISE\n$e";
    }
    main::__out($r);
}
1;
PL
}

// The mounted names, as a Perl list.
fn mounts_pl(h: *child.Host) -> string {
    out = "our @__MOUNTS = ("
    n = child.mount_count(h)
    i = 0
    while i < n {
        name, _min, _max = child.mount_at(h, i)
        out = "${out}'${name}',"
        i = i + 1
    }
    return "${out});\n"
}

main() {
    h, err = child.open("perl-worker")
    if err != "" {
        println(err)
        exit(2)
    }
    if child.read_script(h) != "" { exit(1) }
    // libperl is loaded and the interpreter started here, before the
    // lockdown: afterwards the worker opens nothing. guest.launch gives the
    // worker no environment, so the host names the library as the first
    // argument.
    if os.args_count() > 1 && os.args_get(1) != "" {
        setenv("AETHER_PERL_SONAME", os.args_get(1), 1)
    }
    if perl.init() != 0 {
        child.error(h, "perl-worker: cannot load libperl (AETHER_PERL_SONAME)")
        exit(1)
    }
    mods = "JSON::PP,Time::HiRes"
    if os.args_count() > 2 && os.args_get(2) != "" {
        mods = "${mods},${os.args_get(2)}"
    }
    names = string.split(mods, ",")
    nn = string.array_size(names)
    ni = 0
    while ni < nn {
        m = string.array_get(names, ni)
        if perl.run("require ${m};") != 0 {
            child.error(h, "perl-worker: cannot load ${m}: ${perl.last_error()}")
            exit(1)
        }
        ni = ni + 1
    }
    string.array_free(names)
    if child.is_mounted(h, "export") {
        child.error(h, "perl-worker: cannot mount 'export': the worker defines it for the script")
        exit(1)
    }
    wk = heap.new(Worker)
    wk.h = h
    wk.out = ""
    ghl_keep(wk as ptr)
    perl.register("__out", w_out)
    perl.register("__args", w_args)
    perl.register("__say", w_say)
    perl.register("__call", w_call)
    perl.register("__poll", w_poll)
    if perl.run("${mounts_pl(h)}${prelude()}") != 0 {
        child.error(h, "perl-worker: the prelude failed: ${perl.last_error()}")
        exit(1)
    }
    child.run(h) callback {
        if perl.run(h.source) == 0 {
            serve_guest(h)
        } else {
            child.error(h, perl.last_error())
        }
    }
    exit(0)
}

// After the script: DONE when it exported nothing; otherwise READY, and
// std.guest.child's serve_exports runs, for each INVOKE, _ae_serve in the
// same interpreter until END or a cancel. A cancel heard inside an invocation
// (the SIGALRM handler, or a call's reply) ends the worker: the sub's state
// is half done. std.guest.child's serve_exports sends the answer: a value too
// large for the host's frame is raised and the worker serves on. (Named
// serve_guest: an unqualified call inside child.run's callback block resolves
// to a std.guest.child export of the same name, such as serve or
// serve_exports.)
fn serve_guest(h: *child.Host) {
    wk = worker()
    wk.out = ""
    if perl.run("_ae_ready();") != 0 {
        child.error(h, perl.last_error())
        return
    }
    if wk.out == "" {
        child.done(h, 0)
        return
    }
    child.ready(h, wk.out)
    child.serve_exports(h) callback | sh: *child.Host, inv: child.Invocation | {
        wk.out = ""
        if perl.run("_ae_serve(${child.json_string(inv.name)});") != 0 {
            return child.Reply { kind: "FAIL", text: perl.last_error() }
        }
        out = wk.out
        at = string.index_of(out, "\n")
        text = string.substring(out, at + 1, string.length(out))
        if string.starts_with(out, "RETURN") == 1 { return child.Reply { kind: "VALUE", text: text } }
        return child.Reply { kind: "FAIL", text: text }
    }
}
