// The shared boundary tests (tests/boundary.py) against Perl's in-process
// bridge, through the API it really has: perl.register, perl.run, and a
// callback's arg_str and arg_int and push_str and push_int. Nothing else is
// typed: a Perl value reaches the host as the string it stringifies to, and
// the script's own value never comes back (run returns 0 or -1). Usage:
// boundary_host (the script and the value to give come from the environment;
// tests/lib/inproc says which).
//
// echo(v) prints what arg_str says it received and answers with it; give(id)
// pushes a string or an integer, the only two things there is a call for, and
// prints NOAPI for the rest, which reads n/a; refuse(m) raises an error. Perl has
// no limit, so the loop case is n/a.

import perl
import inproc
import std.json
import std.string

extern exit(code: int)

@c_callback
host_echo(ctx: ptr) -> int {
    n = perl.arg_count(ctx)
    out = "["
    i = 1
    while i <= n {
        if i > 1 { out = "${out}," }
        out = "${out}${inproc.quote(perl.arg_str(ctx, i))}"
        i = i + 1
    }
    inproc.emit("WIRE", "${out}]")
    if n < 1 { return 0 }
    perl.push_str(ctx, perl.arg_str(ctx, 1))
    return 1
}

@c_callback
host_refuse(ctx: ptr) -> int {
    inproc.emit("REFUSE", "")
    return perl.raise_error(ctx, "refused by the host")
}

@c_callback
host_give(ctx: ptr) -> int {
    v, err = json.parse(inproc.give_text())
    if err != "" {
        inproc.emit("NOAPI", "the harness's value is not JSON: ${err}")
        return 0
    }
    kind = json.type(v)
    if kind == json.JSON_STRING {
        s, _x = json.get_string(v)
        perl.push_str(ctx, s)
        return 1
    }
    if kind == json.JSON_NUMBER {
        if json.json_is_integer(v) == 1 {
            perl.push_int(ctx, json.json_get_long(v))
            return 1
        }
    }
    inproc.emit("NOAPI", "the bridge pushes only a string or an integer")
    return 0
}

main() {
    if perl.init() != 0 { println("no perl runtime"); exit(2) }
    perl.register("echo", host_echo)
    perl.register("give", host_give)
    perl.register("refuse", host_refuse)
    if inproc.limited() == 1 {
        inproc.emit("NOAPI", "the bridge has no limit")
        exit(0)
    }
    rc = perl.run(inproc.script())
    if rc == 0 { inproc.emit("END", "DONE ") } else { inproc.emit("END", "ERROR ${perl.last_error()}") }
    exit(0)
}
