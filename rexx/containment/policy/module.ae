// policy: what the in-process host (host.ae) and the contained-child host
// (child_host.ae) share: the policy grammar, the script a row runs, the checks'
// source, and the judge's verdict. add_grant and grants
// are aether's tests/integration/contrib_host_stunt/host.ae, unchanged.

exports(add_grant, grants, script, checks_source, verdict, ended_in_error)

import std.sandbox
import std.os
import std.fs
import std.string

extern exit(code: int)

add_grant(g: sandbox.Grants, item: string) {
    eq = string.index_of(item, "=")
    kind = item
    pat = ""
    if eq >= 0 {
        kind = string.substring(item, 0, eq)
        pat = string.substring(item, eq + 1, string.length(item))
    }
    if kind == "fs_read" { sandbox.grant_fs_read(g, pat) return }
    if kind == "fs_write" { sandbox.grant_fs_write(g, pat) return }
    if kind == "exec" { sandbox.grant_exec(g, pat) return }
    if kind == "env" { sandbox.grant_env(g, pat) return }
    if kind == "native" { sandbox.grant_native(g, pat) return }
    if kind == "fork" { sandbox.grant_fork(g) return }
    if kind == "tcp" {
        host = pat
        port = 0
        colon = string.index_of(pat, ":")
        if colon >= 0 {
            host = string.substring(pat, 0, colon)
            p, perr = string.to_int(string.substring(pat, colon + 1, string.length(pat)))
            if perr == "" { port = p }
        }
        sandbox.grant_tcp(g, host, port)
        return
    }
    println("host: unknown grant kind ${kind}")
    exit(2)
}

grants(spec: string) -> sandbox.Grants {
    g = sandbox.new("rexx") {
    }
    if spec != "-" && spec != "" {
        items = string.split(spec, ",")
        n = string.array_size(items)
        i = 0
        while i < n {
            add_grant(g, string.array_get(items, i))
            i = i + 1
        }
        string.array_free(items)
    }
    return g
}

// The script for one row: the check and the expectation as Rexx variables,
// then checks.rexx, which ends by saying stunt's line.
script(check: string, expect: string) -> string {
    return "LET check = '${check}'\nLET expect = '${expect}'\n${checks_source()}"
}

checks_source() -> string {
    path = os.getenv("REXX_CHECKS")
    if path == "" {
        println("host: REXX_CHECKS is not set (the path of checks.rexx)")
        exit(2)
    }
    text, err = fs.read(path)
    if err != "" {
        println("host: cannot read ${path}: ${err}")
        exit(2)
    }
    return text
}

// The judge's verdict, from the end of the line.
verdict(line: string) -> int {
    if string.ends_with(line, ": PASS") == 1 { return 0 }
    return 1
}

// stunt's line for a script that ended in an error instead of saying one.
// RexxAE has no condition handling (no SIGNAL ON), so a script cannot catch
// a call to a function nobody registered: the engine ends it with "unknown
// or unavailable function: NOPE", and that end is callback-unregistered's
// refusal, judged here by the host. Any other error is an error, never a
// refusal, so it cannot pass for a sandbox at work.
ended_in_error(check: string, expect: string, err: string) -> string {
    outcome = "error"
    if check == "callback-unregistered" && string.contains(err, "unknown or unavailable function: NOPE") == 1 {
        outcome = "refused"
    }
    verdict_word = "FAIL"
    if expect == "refused" && outcome == "refused" { verdict_word = "PASS" }
    return "${check}: ${outcome} (the script ended: ${err}) - expected ${expect}: ${verdict_word}"
}
