// java: Java as a separate JVM process, moved from aether's contrib.host.java
// (PROVENANCE.md).
//
// Unlike Python, Perl, Ruby, Tcl and JS, the JVM is not embedded: it runs in
// a separate process, started by the `java` command, with a Java agent
// (src/, -javaagent) that reads the grant list and the shared map from
// shared memory through the Foreign Function API. aether's module carried no
// C bridge and offered one helper, grant_jvm_runtime(), which bundles the
// standard JVM startup grants every sandboxed Java program needs (libs,
// certs, timezone, JAVA_HOME, etc.): JVM overhead, not application grants. The
// caller started the JVM itself with spawn_sandboxed.
//
// What is new here: the bridge starts it, the way go.run does for a Go
// program (aether_host_java.c is aether_host_go.c with `java` for `go`):
//
//   java.run(classpath, main_class)                 a plain child, no containment
//   java.run_sandboxed(perms, classpath, main_class)
//        the child with libaether_sandbox.so preloaded and the grants in
//        AETHER_SANDBOX_SHM (Linux; on macOS there is no such library, so it
//        starts nothing and returns -1)
//   java.run_sandboxed_with_map(perms, classpath, main_class, map_token)
//        and the shared map in AETHER_MAP_SHM (the agent's AetherMap class
//        reads and writes it)
//
// All three return the JVM's exit status, or -1 when it could not start. The
// command is `$JAVA_BIN $AETHER_JAVA_FLAGS [-javaagent:$AETHER_JAVA_AGENT]
// -cp <classpath> <main_class>` (java on PATH without JAVA_BIN); the agent is
// added to sandboxed runs. JDK 21 needs --enable-preview in
// AETHER_JAVA_FLAGS, where the Foreign Function API is a preview.
//
// For Java contained by the kernel see worker/ and README.md, "4. Contained
// child".
//
// Usage:
//   import java
//   import std.sandbox
//
//   main() {
//       worker = sandbox.new("my-java-app") {
//           java.grant_jvm_runtime()          // JVM bring-up
//           grant_fs_read("/app/data/*")      // application-specific
//           grant_tcp("api.example.com", 443)
//       }
//       rc = java.run_sandboxed(worker, "build/classes", "com.example.Main")
//       sandbox.free(worker)
//   }
@source("aether_host_java.c")

import std.list
import std.sandbox   // sandbox.Grants, the grant list the run_sandboxed calls take

exports (
    grant_jvm_runtime,
    java_run, java_run_sandboxed, java_run_sandboxed_with_map
)

// Run a JVM on `main_class` with `classpath` (a path, or several joined by the
// platform separator), no containment. Returns the exit status, or -1.
extern java_run(classpath: string, main_class: string) -> int

// Run it under the sandbox: libaether_sandbox.so preloaded, the grants in
// AETHER_SANDBOX_SHM. The JVM reads its own runtime before the program runs,
// so the list needs grant_jvm_runtime() or the JDK's directory read.
extern java_run_sandboxed(perms: sandbox.Grants, classpath: string, main_class: string) -> int

// The same, with the shared map for typed input and output (AETHER_MAP_SHM).
extern java_run_sandboxed_with_map(perms: sandbox.Grants, classpath: string, main_class: string, map_token: long) -> int

// Add a (category, pattern) pair to a grant list. Mirrors the idiom
// every example defines locally — we keep the definition local here
// too so this module stays self-contained (no transitive dependency
// on the per-example sandbox library).
_add_jvm_perm(target: ptr, cat: string, pat: string) {
    list.add(target, cat)
    list.add(target, pat)
}

// Bundle of grants the JVM itself needs before any application code
// runs. Covers the overhead of linker probes, trust stores, locale
// data, and the well-known `JAVA_*` env vars. Does NOT grant network
// or filesystem paths under the app's control — callers add those on
// top.
//
// Sources for the path globs: empirically observed during `java
// -version` under strace on Corretto 24 (Debian) and Temurin 21
// (Ubuntu). The list is conservative — it permits reads that the JVM
// performs during class loading and TLS init, nothing more.
grant_jvm_runtime(_ctx: ptr) {
    // Kernel/procfs probes (CPU topology, container detection)
    _add_jvm_perm(_ctx, "fs_read", "/sys/*")
    _add_jvm_perm(_ctx, "fs_read", "/proc/*")

    // JVM installation + shared libs
    _add_jvm_perm(_ctx, "fs_read", "/usr/lib/jvm/*")
    _add_jvm_perm(_ctx, "fs_read", "/usr/lib/*")
    _add_jvm_perm(_ctx, "fs_read", "/lib/*")
    _add_jvm_perm(_ctx, "fs_read", "/lib64/*")
    _add_jvm_perm(_ctx, "fs_read", "/etc/java-*")
    _add_jvm_perm(_ctx, "fs_read", "/etc/alternatives/*")

    // Trust stores + TLS
    _add_jvm_perm(_ctx, "fs_read", "/etc/ssl/*")
    _add_jvm_perm(_ctx, "fs_read", "/etc/pki/*")
    _add_jvm_perm(_ctx, "fs_read", "/etc/ca-certificates/*")

    // Locale + timezone
    _add_jvm_perm(_ctx, "fs_read", "/etc/localtime")
    _add_jvm_perm(_ctx, "fs_read", "/etc/timezone")
    _add_jvm_perm(_ctx, "fs_read", "/usr/share/zoneinfo/*")
    _add_jvm_perm(_ctx, "fs_read", "/usr/share/locale/*")

    // Env vars the JVM reads at startup
    _add_jvm_perm(_ctx, "env", "JAVA_HOME")
    _add_jvm_perm(_ctx, "env", "JAVA_TOOL_OPTIONS")
    _add_jvm_perm(_ctx, "env", "JDK_JAVA_OPTIONS")
    _add_jvm_perm(_ctx, "env", "_JAVA_OPTIONS")
    _add_jvm_perm(_ctx, "env", "CLASSPATH")
    _add_jvm_perm(_ctx, "env", "PATH")
    _add_jvm_perm(_ctx, "env", "HOME")
    _add_jvm_perm(_ctx, "env", "USER")
    _add_jvm_perm(_ctx, "env", "TMPDIR")
    _add_jvm_perm(_ctx, "env", "LANG")
    _add_jvm_perm(_ctx, "env", "LC_*")
    _add_jvm_perm(_ctx, "env", "TZ")

    // Shared-memory plumbing used by the Aether agent
    _add_jvm_perm(_ctx, "env", "AETHER_SANDBOX_SHM")
    _add_jvm_perm(_ctx, "env", "AETHER_MAP_SHM")
}
