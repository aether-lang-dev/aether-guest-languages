// factor: embedded Factor, moved from aether's contrib.host.factor
// (PROVENANCE.md).
//
// Runs Factor (concatenative, stack-based) code inside the Aether process
// via the embed-api fork of Factor's libfactor, which exposes a generic C
// eval-a-string entry point (upstream ships only a process-takeover one).
// The bridge's C is compiled into the program that imports this module
// (@source below); libfactor itself is loaded with dlopen at the first call.
//
// Setup (env, orchestrator-owned):
//   AETHER_FACTOR_SONAME = path to the forked libfactor (else libfactor.so)
//   AETHER_FACTOR_IMAGE  = path to the bootstrapped factor.image
//
// Usage:
//   import factor
//
//   r = factor.eval("USING: math prettyprint ; 2 3 + pprint")   // r = "5"
//   factor.set("x", "10")                     // hand a k-v pair to Factor
//   _ = factor.eval("USING: namespaces math math.parser ; \"x\" get string>number 5 + number>string \"x\" set-global")
//   v = factor.get("x")                       // v = "15" (read it back)
//
// The VM is persistent across calls, so set/eval/get share state: a live
// k-v map handed in and read back, same process. README.md has the four
// ways to run Factor from Aether, and what contains it in each.
@source("aether_host_factor.c")

import std.sandbox   // sandbox.Grants, the grant list the run_sandboxed calls take


exports (factor_run_sandboxed, factor_run_sandboxed_with_map,
         factor_run, factor_eval,
         factor_set, factor_get, factor_init, factor_finalize)

extern factor_run_sandboxed(perms: sandbox.Grants, code: string) -> int
// First-class shared map: the Factor script reads/writes the Aether-owned
// shared map live via FFI words aether-map-get / aether-map-put, so keys the
// script discovers at runtime come back too. Enumerate with map.keys(map).
extern factor_run_sandboxed_with_map(perms: sandbox.Grants, code: string, map_token: long) -> int
extern factor_run(code: string) -> int
// Evaluate `code` in the persistent VM; returns its captured output as a
// string ("" on failure). State persists across calls. The string is a
// fresh one the caller owns.
extern factor_eval(code: string) -> string @heap
// Live k-v map over the persistent VM's global namespace.
extern factor_set(key: string, value: string) -> int
extern factor_get(key: string) -> string @heap
extern factor_init() -> int
extern factor_finalize()
