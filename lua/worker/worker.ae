// lua-worker: Lua in a contained child, the guest's side of std.guest.
//
// A host starts this with guest.launch (sandbox.spawn_socket: Landlock and
// seccomp on Linux; refused on macOS and Windows, where nothing starts) and
// sends it the functions it may call (MOUNT) and a Lua script (SCRIPT). The
// worker loads liblua (AETHER_LUA_SONAME, else liblua.so) before it locks
// itself down, then runs the script in the bridge's two-way VM inside
// std.guest.child's lockdown:
//
//   print(...)          SAY, the arguments tostring'd and tab-joined
//   NAME(...)           for each mounted NAME: CALL NAME [args as JSON],
//                       the host's answer decoded back to Lua (a granted file
//                       is {granted = true, text = ...}); a FAIL is nil and
//                       the message; a CANCEL ends the script
//   the end             DONE 0, or ERROR and Lua's message
//
// Usage (by a host): lua-worker [<liblua soname or path>]
//
// A CANCEL is looked for every 1000 VM instructions from a debug.sethook
// count hook (std.guest's "interrupt hook" engine), and in every call's
// reply. A script that removes the hook stops answering, and the host kills
// it after its grace period: the containment is the host's, not the hook's.

import lua
import std.guest.child
import std.os
import std.string

extern exit(code: int)
extern setenv(name: string, value: string, overwrite: int) -> int
extern ghl_keep(p: ptr)
extern ghl_kept() -> ptr

@source("worker_support.c")

// The Host the callbacks below answer through (one per process).
fn host() -> *child.Host {
    return ghl_kept() as *child.Host
}

// __say(text)
@c_callback
w_say(vm: ptr) -> int {
    child.say(host(), lua.arg_str(vm, 1))
    return 0
}

// __call(name, args_json) -> kind, text
@c_callback
w_call(vm: ptr) -> int {
    r = child.call_host(host(), lua.arg_str(vm, 1), lua.arg_str(vm, 2))
    lua.push_str(vm, r.kind)
    lua.push_str(vm, r.text)
    return 2
}

// __poll() -> "" or the reason the host cancelled
@c_callback
w_poll(vm: ptr) -> int {
    lua.push_str(vm, child.poll(host()))
    return 1
}

// The glue between Lua and the protocol, run before the script.
fn prelude() -> string {
    return <<LUA
local say, call, poll = __say, __call, __poll
__say, __call, __poll = nil, nil, nil

function print(...)
  local n, t = select('#', ...), {}
  for i = 1, n do t[i] = tostring((select(i, ...))) end
  say(table.concat(t, "\t"))
end

local function enc(v)
  local ty = type(v)
  if ty == "string" then
    return '"' .. v:gsub('[%c"\\]', function(c)
      local m = { ['"'] = '\\"', ['\\'] = '\\\\', ['\n'] = '\\n', ['\r'] = '\\r', ['\t'] = '\\t' }
      return m[c] or string.format('\\u%04x', c:byte())
    end) .. '"'
  elseif ty == "number" then
    if math.type(v) == "integer" then return tostring(v) end
    return string.format("%.17g", v)
  elseif ty == "boolean" then return tostring(v)
  elseif v == nil then return "null"
  end
  error("a host function takes strings, numbers, booleans and nil, not a " .. ty, 3)
end

local function dec(s)
  local i = 1
  local function ws() i = s:find("[^ \t\r\n]", i) or #s + 1 end
  local val
  local function str()
    local out, j = {}, i + 1
    while true do
      local c = s:sub(j, j)
      if c == "" then error("JSON: unterminated string") end
      if c == '"' then i = j + 1; return table.concat(out) end
      if c == "\\" then
        local e = s:sub(j + 1, j + 1)
        local m = { b = "\b", f = "\f", n = "\n", r = "\r", t = "\t" }
        if e == "u" then
          out[#out + 1] = utf8.char(tonumber(s:sub(j + 2, j + 5), 16)); j = j + 6
        else
          out[#out + 1] = m[e] or e; j = j + 2
        end
      else
        out[#out + 1] = c; j = j + 1
      end
    end
  end
  function val()
    ws()
    local c = s:sub(i, i)
    if c == '"' then return str()
    elseif c == "{" then
      local t = {}; i = i + 1; ws()
      if s:sub(i, i) == "}" then i = i + 1; return t end
      while true do
        ws(); local k = str(); ws(); i = i + 1
        t[k] = val(); ws()
        local d = s:sub(i, i); i = i + 1
        if d == "}" then return t end
      end
    elseif c == "[" then
      local t = {}; i = i + 1; ws()
      if s:sub(i, i) == "]" then i = i + 1; return t end
      while true do
        t[#t + 1] = val(); ws()
        local d = s:sub(i, i); i = i + 1
        if d == "]" then return t end
      end
    elseif s:sub(i, i + 3) == "true" then i = i + 4; return true
    elseif s:sub(i, i + 4) == "false" then i = i + 5; return false
    elseif s:sub(i, i + 3) == "null" then i = i + 4; return nil
    else
      local num = s:match("^-?%d+%.?%d*[eE]?[-+]?%d*", i)
      i = i + #num
      return math.tointeger(tonumber(num)) or tonumber(num)
    end
  end
  return val()
end

for _, name in ipairs(__MOUNTS) do
  _G[name] = function(...)
    local n, args = select('#', ...), {}
    for k = 1, n do args[k] = enc((select(k, ...))) end
    local kind, text = call(name, "[" .. table.concat(args, ",") .. "]")
    if kind == "VALUE" then return dec(text) end
    if kind == "CANCEL" then error("cancelled by host: " .. text, 0) end
    return nil, text
  end
end
__MOUNTS = nil

debug.sethook(function()
  local why = poll()
  if why ~= "" then error("cancelled by host: " .. why, 0) end
end, "", 1000)
LUA
}

// The mounted names, as a Lua array literal.
fn mounts_lua(h: *child.Host) -> string {
    out = "__MOUNTS = {"
    n = child.mount_count(h)
    i = 0
    while i < n {
        name, _min, _max = child.mount_at(h, i)
        out = "${out}\"${name}\","
        i = i + 1
    }
    return "${out}}\n"
}

main() {
    h, err = child.open("lua-worker")
    if err != "" {
        println(err)
        exit(2)
    }
    if child.read_script(h) != "" { exit(1) }
    // liblua is loaded here, before the lockdown: afterwards the worker
    // opens nothing. guest.launch gives the worker no environment, so the
    // host names the library as the first argument.
    if os.args_count() > 1 && os.args_get(1) != "" {
        setenv("AETHER_LUA_SONAME", os.args_get(1), 1)
    }
    vm = lua.vm_new()
    if vm == null {
        child.error(h, "lua-worker: cannot load liblua (AETHER_LUA_SONAME)")
        exit(1)
    }
    ghl_keep(h as ptr)
    lua.vm_register(vm, "__say", w_say)
    lua.vm_register(vm, "__call", w_call)
    lua.vm_register(vm, "__poll", w_poll)
    if lua.vm_eval(vm, "${mounts_lua(h)}${prelude()}") != 0 {
        child.error(h, "lua-worker: the prelude failed: ${lua.vm_result_str(vm)}")
        exit(1)
    }
    lua.vm_pop_result(vm)
    child.run(h) callback {
        if lua.vm_eval(vm, h.source) == 0 {
            child.done(h, 0)
        } else {
            child.error(h, lua.vm_result_str(vm))
        }
    }
    exit(0)
}
