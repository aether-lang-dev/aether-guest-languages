// lua-worker: Lua in a contained child, the guest's side of std.guest.
//
// A host starts this with guest.launch (sandbox.spawn_socket: Landlock and
// seccomp on Linux; refused on macOS and Windows, where nothing starts) and
// sends it the functions it may call (MOUNT) and a Lua script (SCRIPT). The
// worker loads liblua (AETHER_LUA_SONAME, else liblua.so) before it locks
// itself down, then runs the script in the bridge's two-way VM inside
// std.guest.child's lockdown:
//
//   print(...)          SAY, the arguments tostring'd and tab-joined
//   NAME(...)           for each mounted NAME: CALL NAME [args as JSON],
//                       the host's answer decoded back to Lua (a granted file
//                       is {granted = true, text = ...}); a FAIL is nil and
//                       the message; a CANCEL ends the script
//   the end             DONE 0, or ERROR and Lua's message
//   export(name, fn)    marks fn for the host to call by name once the script
//                       has ended (export(name) takes the global function of
//                       that name). A script that exported anything ends with
//                       READY and its names instead of DONE, and serves: each
//                       INVOKE calls the function with its JSON arguments in
//                       the same VM (the script's globals, upvalues and
//                       modules as it left them) and is answered RETURN and
//                       the first result as JSON, or RAISE and Lua's message,
//                       after which it serves on; END ends it with DONE 0. The
//                       names are fixed at READY. `export` is the worker's
//                       name: a host cannot mount it.
//
// Usage (by a host): lua-worker [<liblua soname or path>]
//
// A CANCEL is looked for every 1000 VM instructions from a debug.sethook
// count hook (std.guest's "interrupt hook" engine), and in every call's
// reply. A script that removes the hook stops answering, and the host kills
// it after its grace period: the containment is the host's, not the hook's.

import lua
import std.guest.child
import std.os
import std.string

extern exit(code: int)
extern setenv(name: string, value: string, overwrite: int) -> int
extern ghl_keep(p: ptr)
extern ghl_kept() -> ptr

@source("worker_support.c")

// The Host the callbacks below answer through (one per process).
fn host() -> *child.Host {
    return ghl_kept() as *child.Host
}

// __say(text)
@c_callback
w_say(vm: ptr) -> int {
    child.say(host(), lua.arg_str(vm, 1))
    return 0
}

// __call(name, args_json) -> kind, text
@c_callback
w_call(vm: ptr) -> int {
    r = child.call_host(host(), lua.arg_str(vm, 1), lua.arg_str(vm, 2))
    lua.push_str(vm, r.kind)
    lua.push_str(vm, r.text)
    return 2
}

// __poll() -> "" or the reason the host cancelled
@c_callback
w_poll(vm: ptr) -> int {
    lua.push_str(vm, child.poll(host()))
    return 1
}

// __args() -> the arguments of the invocation being served, a JSON array
@c_callback
w_args(vm: ptr) -> int {
    lua.push_str(vm, host().invoked)
    return 1
}

// The glue between Lua and the protocol, run before the script.
fn prelude() -> string {
    return <<LUA
local say, call, poll, args = __say, __call, __poll, __args
__say, __call, __poll, __args = nil, nil, nil, nil

function print(...)
  local n, t = select('#', ...), {}
  for i = 1, n do t[i] = tostring((select(i, ...))) end
  say(table.concat(t, "\t"))
end

local function enc(v)
  local ty = type(v)
  if ty == "string" then
    return '"' .. v:gsub('[%c"\\]', function(c)
      local m = { ['"'] = '\\"', ['\\'] = '\\\\', ['\n'] = '\\n', ['\r'] = '\\r', ['\t'] = '\\t' }
      return m[c] or string.format('\\u%04x', c:byte())
    end) .. '"'
  elseif ty == "number" then
    if math.type(v) == "integer" then return tostring(v) end
    return string.format("%.17g", v)
  elseif ty == "boolean" then return tostring(v)
  elseif v == nil then return "null"
  end
  error("a host function takes strings, numbers, booleans and nil, not a " .. ty, 3)
end

-- How many values the last array dec finished held (nil included): the
-- outermost array is the last to finish, so after dec(args) it is the count.
local arrcount = 0

local function dec(s)
  local i = 1
  local function ws() i = s:find("[^ \t\r\n]", i) or #s + 1 end
  local val
  local function str()
    local out, j = {}, i + 1
    while true do
      local c = s:sub(j, j)
      if c == "" then error("JSON: unterminated string") end
      if c == '"' then i = j + 1; return table.concat(out) end
      if c == "\\" then
        local e = s:sub(j + 1, j + 1)
        local m = { b = "\b", f = "\f", n = "\n", r = "\r", t = "\t" }
        if e == "u" then
          out[#out + 1] = utf8.char(tonumber(s:sub(j + 2, j + 5), 16)); j = j + 6
        else
          out[#out + 1] = m[e] or e; j = j + 2
        end
      else
        out[#out + 1] = c; j = j + 1
      end
    end
  end
  function val()
    ws()
    local c = s:sub(i, i)
    if c == '"' then return str()
    elseif c == "{" then
      local t = {}; i = i + 1; ws()
      if s:sub(i, i) == "}" then i = i + 1; return t end
      while true do
        ws(); local k = str(); ws(); i = i + 1
        t[k] = val(); ws()
        local d = s:sub(i, i); i = i + 1
        if d == "}" then return t end
      end
    elseif c == "[" then
      local t, k = {}, 0; i = i + 1; ws()
      if s:sub(i, i) == "]" then i = i + 1; arrcount = 0; return t end
      while true do
        k = k + 1
        t[k] = val(); ws()
        local d = s:sub(i, i); i = i + 1
        if d == "]" then arrcount = k; return t end
      end
    elseif s:sub(i, i + 3) == "true" then i = i + 4; return true
    elseif s:sub(i, i + 4) == "false" then i = i + 5; return false
    elseif s:sub(i, i + 3) == "null" then i = i + 4; return nil
    else
      local num = s:match("^-?%d+%.?%d*[eE]?[-+]?%d*", i)
      i = i + #num
      return math.tointeger(tonumber(num)) or tonumber(num)
    end
  end
  return val()
end

for _, name in ipairs(__MOUNTS) do
  _G[name] = function(...)
    local n, args = select('#', ...), {}
    for k = 1, n do args[k] = enc((select(k, ...))) end
    local kind, text = call(name, "[" .. table.concat(args, ",") .. "]")
    if kind == "VALUE" then return dec(text) end
    if kind == "CANCEL" then error("cancelled by host: " .. text, 0) end
    return nil, text
  end
end
__MOUNTS = nil

-- Exports: functions the host may call by name once the script has ended.
local exports, order, served = {}, {}, {}

function export(name, fn)
  if type(name) ~= "string" then error("export: the name must be a string", 2) end
  if fn == nil then fn = _G[name] end
  if type(fn) ~= "function" then error("export: " .. name .. " is not a function", 2) end
  if exports[name] == nil then order[#order + 1] = name end
  exports[name] = fn
end

-- The names at READY, fixed from here on, as a JSON array; "" for none.
function __ae_ready()
  local names = {}
  for _, n in ipairs(order) do served[n] = exports[n]; names[#names + 1] = enc(n) end
  if #names == 0 then return "" end
  return "[" .. table.concat(names, ",") .. "]"
end

-- One INVOKE: "RETURN\n<json>" or "RAISE\n<message>".
function __ae_serve(name)
  local fn = served[name]
  if fn == nil then return "RAISE\nno export named " .. name end
  local a = dec(args())
  local r = table.pack(pcall(fn, table.unpack(a, 1, arrcount)))
  if not r[1] then return "RAISE\n" .. tostring(r[2]) end
  local ok, j = pcall(enc, r[2])
  if not ok then return "RAISE\nthe value returned: " .. tostring(j):gsub("^%[string .-%]:%d+: ", "") end
  return "RETURN\n" .. j
end

debug.sethook(function()
  local why = poll()
  if why ~= "" then error("cancelled by host: " .. why, 0) end
end, "", 1000)
LUA
}

// The mounted names, as a Lua array literal.
fn mounts_lua(h: *child.Host) -> string {
    out = "__MOUNTS = {"
    n = child.mount_count(h)
    i = 0
    while i < n {
        name, _min, _max = child.mount_at(h, i)
        out = "${out}\"${name}\","
        i = i + 1
    }
    return "${out}}\n"
}

main() {
    h, err = child.open("lua-worker")
    if err != "" {
        println(err)
        exit(2)
    }
    if child.read_script(h) != "" { exit(1) }
    // liblua is loaded here, before the lockdown: afterwards the worker
    // opens nothing. guest.launch gives the worker no environment, so the
    // host names the library as the first argument.
    if os.args_count() > 1 && os.args_get(1) != "" {
        setenv("AETHER_LUA_SONAME", os.args_get(1), 1)
    }
    vm = lua.vm_new()
    if vm == null {
        child.error(h, "lua-worker: cannot load liblua (AETHER_LUA_SONAME)")
        exit(1)
    }
    if child.is_mounted(h, "export") {
        child.error(h, "lua-worker: cannot mount 'export': the worker defines it for the script")
        exit(1)
    }
    ghl_keep(h as ptr)
    lua.vm_register(vm, "__args", w_args)
    lua.vm_register(vm, "__say", w_say)
    lua.vm_register(vm, "__call", w_call)
    lua.vm_register(vm, "__poll", w_poll)
    if lua.vm_eval(vm, "${mounts_lua(h)}${prelude()}") != 0 {
        child.error(h, "lua-worker: the prelude failed: ${lua.vm_result_str(vm)}")
        exit(1)
    }
    lua.vm_pop_result(vm)
    child.run(h) callback {
        if lua.vm_eval(vm, h.source) == 0 {
            lua.vm_pop_result(vm)
            serve_guest(vm, h)
        } else {
            child.error(h, lua.vm_result_str(vm))
        }
    }
    exit(0)
}

// After the script: DONE when it exported nothing; otherwise READY, and
// std.guest.child's serve_exports runs, for each INVOKE, __ae_serve in the
// same VM until END or a cancel. A cancel heard inside an invocation (the
// count hook, or a call's reply) ends the worker: the function's state is
// half done. std.guest.child's serve_exports sends the answer: a value too
// large for the host's frame is raised and the worker serves on. (Named
// serve_guest: an unqualified call inside child.run's callback block resolves
// to a std.guest.child export of the same name, such as serve or
// serve_exports.)
fn serve_guest(vm: ptr, h: *child.Host) {
    lua.vm_eval(vm, "return __ae_ready()")
    names = lua.vm_result_str(vm)
    lua.vm_pop_result(vm)
    if names == "" {
        child.done(h, 0)
        return
    }
    child.ready(h, names)
    child.serve_exports(h) callback | sh: *child.Host, inv: child.Invocation | {
        if lua.vm_eval(vm, "return __ae_serve(${child.json_string(inv.name)})") != 0 {
            return child.Reply { kind: "FAIL", text: lua.vm_result_str(vm) }
        }
        out = lua.vm_result_str(vm)
        lua.vm_pop_result(vm)
        at = string.index_of(out, "\n")
        text = string.substring(out, at + 1, string.length(out))
        if string.starts_with(out, "RETURN") == 1 { return child.Reply { kind: "VALUE", text: text } }
        return child.Reply { kind: "FAIL", text: text }
    }
}
