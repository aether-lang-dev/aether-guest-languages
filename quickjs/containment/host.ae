// The host the containment tests drive (tests/test_stunt_*.sh). Usage:
//
//   host inproc <policy> <check> <expectation>
//
// Runs one row of stunt's catalogue (aether contrib/host/stunt), written in
// JavaScript (checks.js beside this, or $QUICKJS_CHECKS), in the QuickJS
// bridge in this process, under the policy's grants, and prints stunt's line
// for it:
//
//   <check>: <outcome> (<detail>) - expected <expectation>: PASS|FAIL
//
// exiting 0 when it matched. QuickJS has no I/O of its own (quickjs-libc is
// not compiled in), so there is nothing for libaether_sandbox.so (LD_PRELOAD)
// to hold from the interpreter itself, and the bridge gives a script no
// binding that reaches the system. What a script reaches is the host
// functions below, which check the grants themselves, as stunt's host does.
//
// Two of the bridge's entry points carry a row, as in lua/containment/host.ae:
//   - quickjs.run_sandboxed_with_map, the bridge's own sandboxed run, for
//     the shared-map rows. The line comes back through the map, as an output
//     the script writes.
//   - the two-way VM (quickjs.vm_*) inside sandbox.enforce, for the rows that
//     call host functions (binding-*, callback-*) and for spin, which needs
//     the time limit. read_file and getenv check the grants themselves.
//
// <policy> is "-" for no grants, or kind=pattern,... with kinds fs_read,
// fs_write, exec, env, tcp (host:port), native, fork. "<outer>|<inner>"
// runs the check inside sandbox.enforce(<outer>), so the bridge's level
// nests in the block's. The policy grammar is in policy/module.ae; the
// contained child's host is child_host.ae.

@source("host_support.c")

import quickjs
import policy
import std.sandbox
import std.os
import std.fs
import std.list
import std.string
import std.time

extern exit(code: int)
extern aether_sandbox_depth() -> int
// 1 when every level in force grants it (runtime/aether_sandbox.h).
extern aether_sandbox_check_slow(category: string, resource: string) -> int
extern ghl_map_new() -> long
extern ghl_map_put(key: @aether string, value: @aether string)
extern ghl_map_get(key: @aether string) -> string @heap
extern ghl_stdin_null()

// ---- host functions the guest calls (the two-way VM) ------------------------
//
// A refusal or a failure is an Error thrown into the script, whose message is
// what the script's check reads: "refused: ..." for the grants saying no.

// read_file(path): the file's text.
@c_callback
host_read_file(vm: ptr) -> int {
    path = quickjs.arg_str(vm, 1)
    if aether_sandbox_check_slow("fs_read", path) == 0 {
        return quickjs.raise_error(vm, "refused: fs_read ${path}")
    }
    text, err = fs.read(path)
    if err != "" { return quickjs.raise_error(vm, err) }
    quickjs.push_str(vm, text)
    return 1
}

// getenv(name): the variable's value.
@c_callback
host_getenv(vm: ptr) -> int {
    name = quickjs.arg_str(vm, 1)
    if aether_sandbox_check_slow("env", name) == 0 {
        return quickjs.raise_error(vm, "refused: env ${name}")
    }
    v = os.getenv(name)
    if v == "" { return quickjs.raise_error(vm, "${name} is unset") }
    quickjs.push_str(vm, v)
    return 1
}

@c_callback
host_greet(vm: ptr) -> int {
    quickjs.push_str(vm, "hello, ${quickjs.arg_str(vm, 1)}")
    return 1
}

@c_callback
host_add(vm: ptr) -> int {
    if quickjs.arg_type(vm, 1) != quickjs.QJS_TINT || quickjs.arg_type(vm, 2) != quickjs.QJS_TINT {
        return quickjs.raise_error(vm, "add takes two ints")
    }
    quickjs.push_int(vm, quickjs.arg_int(vm, 1) + quickjs.arg_int(vm, 2))
    return 1
}

// ---- the rows ---------------------------------------------------------------

// Which entry point carries a row: the two-way VM for host functions and
// spin, the bridge's sandboxed run for the rest.
fn uses_vm(check: string) -> int {
    if string.starts_with(check, "binding-") == 1 { return 1 }
    if string.starts_with(check, "callback-") == 1 { return 1 }
    if check == "spin" { return 1 }
    return 0
}

fn run_vm(g: sandbox.Grants, check: string, expect: string, source: string) -> string {
    vm = quickjs.vm_new_capped(65536)
    if vm == null {
        println("host: cannot make a QuickJS VM")
        exit(1)
    }
    quickjs.vm_register(vm, "read_file", host_read_file)
    quickjs.vm_register(vm, "getenv", host_getenv)
    quickjs.vm_register(vm, "greet", host_greet)
    quickjs.vm_register(vm, "add", host_add)
    box = list.new()
    if check == "spin" {
        // A loop only the time limit can end: it must end with the limit's
        // error, and not before the limit.
        quickjs.vm_set_time_limit(vm, 1000, 1)
        t0 = time.now_ms()
        sandbox.enforce(g) callback {
            rc = quickjs.vm_eval(vm, "${source}\nvar n = 0; for (;;) { n++; }")
            list.add(box, "${rc}\t${quickjs.vm_result_str(vm)}")
        }
        ms = time.now_ms() - t0
        quickjs.vm_free(vm)
        got, _e = list.get_string(box, 0)
        out = string.copy(got)
        list.free(box)
        tab = string.index_of(out, "\t")
        rc_text = string.substring(out, 0, tab)
        msg = string.substring(out, tab + 1, string.length(out))
        if rc_text != "0" && string.contains(msg, "time limit") == 1 && ms >= 900 {
            return "spin: stopped at the time limit (${msg}, after ${ms} ms) - host-checked: PASS"
        }
        return "spin: rc ${rc_text} (${msg}) after ${ms} ms - host-checked: FAIL"
    }
    quickjs.vm_set_time_limit(vm, 5000, 1)
    sandbox.enforce(g) callback {
        rc = quickjs.vm_eval(vm, "${source}\ncheck_line(\"${check}\", \"${expect}\")")
        if rc != 0 {
            list.add(box, "${check}: the script failed (${quickjs.vm_result_str(vm)}) - expected ${expect}: FAIL")
        } else if quickjs.vm_result_type(vm) != quickjs.QJS_TSTR {
            list.add(box, "${check}: check_line gave a ${quickjs.vm_result_type(vm)}, not a string - expected ${expect}: FAIL")
        } else {
            list.add(box, quickjs.vm_result_str(vm))
        }
    }
    quickjs.vm_free(vm)
    got, _e = list.get_string(box, 0)
    out = string.copy(got)
    list.free(box)
    return out
}

fn run_bridge(g: sandbox.Grants, check: string, expect: string, source: string) -> string {
    token = ghl_map_new()
    ghl_map_put("input", "stunt-in")
    rc = quickjs.run_sandboxed_with_map(g, "${source}\naether_map_put(\"line\", check_line(\"${check}\", \"${expect}\"));", token)
    line = ghl_map_get("line")
    if rc != 0 || line == "" {
        return "${check}: the script failed (run_sandboxed_with_map returned ${rc}) - expected ${expect}: FAIL"
    }
    return line
}

fn run_row(g: sandbox.Grants, check: string, expect: string, source: string) -> string {
    if uses_vm(check) == 1 { return run_vm(g, check, expect, source) }
    return run_bridge(g, check, expect, source)
}

fn finish(line: string, before: int, check: string) {
    after = aether_sandbox_depth()
    if after != before {
        println("host: ${check}: the bridge left ${after - before} level(s) in force")
        exit(1)
    }
    println(line)
    exit(policy.verdict(line))
}

fn run_inproc(spec: string, check: string, expect: string) {
    source = "${policy.facts()}${policy.checks_source()}"
    bar = string.index_of(spec, "|")
    if bar < 0 {
        before = aether_sandbox_depth()
        finish(run_row(policy.grants(spec), check, expect, source), before, check)
        return
    }
    outer = policy.grants(string.substring(spec, 0, bar))
    inner = policy.grants(string.substring(spec, bar + 1, string.length(spec)))
    sandbox.enforce(outer) callback {
        if aether_sandbox_depth() != 1 {
            println("host: the enforce block is not one level deep")
            exit(1)
        }
        before = aether_sandbox_depth()
        finish(run_row(inner, check, expect, source), before, check)
    }
}


main() {
    if os.args_count() != 5 {
        println("usage: host inproc <policy> <check> <expectation>")
        exit(2)
    }
    mode = os.args_get(1)
    if mode == "inproc" {
        ghl_stdin_null()
        run_inproc(os.args_get(2), os.args_get(3), os.args_get(4))
    } else {
        println("host: unknown mode ${mode}")
        exit(2)
    }
}
