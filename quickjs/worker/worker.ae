// quickjs-worker: QuickJS in a contained child, the guest's side of std.guest.
//
// A host starts this with guest.launch (sandbox.spawn_socket: Landlock and
// seccomp on Linux; refused on macOS and Windows, where nothing starts) and
// sends it the functions it may call (MOUNT) and a JavaScript script
// (SCRIPT). The worker runs the script in the bridge's two-way VM
// (`import quickjs`, on aether's contrib.quickjs, compiled into this program)
// inside std.guest.child's lockdown:
//
//   print(...), console.log(...)
//                       SAY, the arguments String()'d and space-joined
//   NAME(...)           for each mounted NAME: CALL NAME [args as JSON]
//                       (strings, numbers, booleans, null, arrays, objects),
//                       the host's answer decoded back (JSON.parse; a granted
//                       file is {granted: true, text: ...}); a FAIL throws an
//                       Error with the host's message, which the script can
//                       catch; a CANCEL ends the script
//   the end             DONE 0, or ERROR and the error ("TypeError: ...")
//   export_fn(name, fn) marks fn for the host to call by name once the script
//                       has ended (`export` is a reserved word in JavaScript;
//                       export_fn(fn) takes the function's own name). A
//                       script that exported anything ends with READY and its
//                       names instead of DONE, and serves: each INVOKE calls
//                       the function with its JSON arguments in the same
//                       runtime (the script's globals and closures as it left
//                       them) and is answered RETURN and the value as JSON
//                       (undefined is null), or RAISE and the error as the
//                       script's ERROR would say it, after which it serves
//                       on; END ends it with DONE 0. The names are fixed at
//                       READY. `export_fn` is the worker's name: a host cannot
//                       mount it.
//
// A CANCEL is heard inside a loop as well as in a call's reply: a watcher
// thread (worker_support.c) waits on the socket while the script runs and,
// when the host speaks unasked, sets the VM's cancel cell, which stops the
// JavaScript where it is, uncatchably. The worker then reads the CANCEL and
// ends with ERROR "cancelled by host: <the host's reason>", as the Lua,
// Python, Perl, Ruby and Tcl workers do. The host's kill after its grace
// period is still what holds a worker that does not answer.
//
// QuickJS has no standard library on disk, no I/O of its own and (quickjs-libc
// not being compiled in) no module loader, and the engine is part of this
// program: there is nothing to load, so nothing is opened before the lockdown
// and the worker takes no arguments.
//
// Usage (by a host): quickjs-worker

@source("worker_support.c")

import quickjs
import std.guest.child
import std.list
import std.string
import std.sync

extern exit(code: int)
extern ghl_watch_start(fd: int, cell: ptr) -> ptr
extern ghl_watch_call(w: ptr, on: int)
extern ghl_watch_stop(w: ptr)

// What the callbacks need, through the VM's user pointer.
struct Worker {
    h: *child.Host
    watch: ptr
    cell: ptr
}

fn worker_of(vm: ptr) -> *Worker {
    return quickjs.vm_user(vm) as *Worker
}

// __say(text)
@c_callback
w_say(vm: ptr) -> int {
    child.say(worker_of(vm).h, quickjs.arg_str(vm, 1))
    return 0
}

// __call(name, args_json): the host's answer as a value, or an Error.
@c_callback
w_call(vm: ptr) -> int {
    w = worker_of(vm)
    ghl_watch_call(w.watch, 1)
    r = child.call_host(w.h, quickjs.arg_str(vm, 1), quickjs.arg_str(vm, 2))
    ghl_watch_call(w.watch, 0)
    if r.kind == "VALUE" {
        if quickjs.push_json(vm, r.text) != 0 { return quickjs.raise_error(vm, "the host's answer is not JSON") }
        return 1
    }
    if r.kind == "CANCEL" {
        // Stops the script at its next step even if it catches this.
        sync.atomic_store(w.cell, 1)
        return quickjs.raise_error(vm, "cancelled by host: ${r.text}")
    }
    return quickjs.raise_error(vm, r.text)
}

// __args(): the arguments of the invocation being served, an array.
@c_callback
w_args(vm: ptr) -> int {
    if quickjs.push_json(vm, worker_of(vm).h.invoked) != 0 { return quickjs.raise_error(vm, "the arguments are not JSON") }
    return 1
}

// The glue between JavaScript and the protocol, run before the script.
fn prelude() -> string {
    return <<JS
(function () {
  const say = __say, call = __call, args = __args, mounts = __MOUNTS;
  delete globalThis.__say; delete globalThis.__call; delete globalThis.__args; delete globalThis.__MOUNTS;
  function str(v) { try { return String(v); } catch (e) { return '[' + typeof v + ']'; } }
  function print(...a) { say(a.map(str).join(' ')); }
  globalThis.print = print;
  globalThis.console = { log: print };
  for (const name of mounts) {
    globalThis[name] = function (...args) { return call(name, JSON.stringify(args)); };
  }
  // Exports: functions the host may call by name once the script has ended.
  const exports = new Map(), served = new Map();
  globalThis.export_fn = function (name, fn) {
    if (typeof name === 'function' && fn === undefined) { fn = name; name = fn.name; }
    if (typeof name !== 'string' || name === '') throw new TypeError('export_fn: the name must be a non-empty string');
    if (typeof fn !== 'function') throw new TypeError('export_fn: ' + name + ' is not a function');
    exports.set(name, fn);
  };
  // The names at READY, fixed from here on; '' for none.
  globalThis.__ae_ready = function () {
    for (const [n, f] of exports) served.set(n, f);
    return served.size ? JSON.stringify([...served.keys()]) : '';
  };
  // One INVOKE: 'RETURN\n<json>' or 'RAISE\n<error>'.
  globalThis.__ae_serve = function (name) {
    const fn = served.get(name);
    if (!fn) return 'RAISE\nReferenceError: no export named ' + name;
    try {
      const v = JSON.stringify(fn(...args()));
      return 'RETURN\n' + (v === undefined ? 'null' : v);
    } catch (e) {
      return 'RAISE\n' + str(e);
    }
  };
})();
JS
}

main() {
    h, err = child.open("quickjs-worker")
    if err != "" {
        println(err)
        exit(2)
    }
    if child.read_script(h) != "" { exit(1) }
    // 64 MiB of heap, the default stack. No time limit: the host's deadline
    // and CANCEL end a script.
    vm = quickjs.vm_new_capped(65536)
    if vm == null {
        child.error(h, "quickjs-worker: cannot make a QuickJS runtime")
        exit(1)
    }
    cell = sync.atomic_new(0)
    quickjs.vm_set_cancel_cell(vm, cell)
    w = heap.new(Worker)
    w.h = h
    w.cell = cell
    w.watch = null
    quickjs.vm_set_user(vm, w as ptr)
    quickjs.vm_register(vm, "__say", w_say)
    quickjs.vm_register(vm, "__call", w_call)
    quickjs.vm_register(vm, "__args", w_args)
    names = list.new()
    n = child.mount_count(h)
    i = 0
    while i < n {
        name, _min, _max = child.mount_at(h, i)
        // The prelude defines export_fn for the script: it would shadow a
        // host function mounted under that name.
        if name == "export_fn" {
            child.error(h, "quickjs-worker: cannot mount 'export_fn': the worker defines it for the script")
            exit(1)
        }
        list.add(names, name)
        i = i + 1
    }
    quickjs.vm_set_global_strlist(vm, "__MOUNTS", names)
    list.free(names)
    if quickjs.vm_eval(vm, prelude()) != 0 {
        child.error(h, "quickjs-worker: the prelude failed: ${quickjs.vm_result_str(vm)}")
        exit(1)
    }
    quickjs.vm_pop_result(vm)
    child.run(h) callback {
        w.watch = ghl_watch_start(h.ch, cell)
        rc = quickjs.vm_eval(vm, h.source)
        if rc == 0 {
            quickjs.vm_pop_result(vm)
            // The watcher stays on while the guest serves (serve_exports).
            serve_exports(vm, w)
        } else if h.cancel != "" || quickjs.vm_result_str(vm) == "InternalError: interrupted: cancelled" {
            // The watcher saw the host speak; read what it said.
            ghl_watch_stop(w.watch)
            w.watch = null
            why = child.poll(h)
            child.error(h, "cancelled by host: ${why}")
        } else {
            child.error(h, quickjs.vm_result_str(vm))
        }
        ghl_watch_stop(w.watch)
        w.watch = null
    }
    quickjs.vm_set_cancel_cell(vm, null)
    quickjs.vm_free(vm)
    sync.atomic_free(cell)
    heap.free(w)
    child.free(h)
    exit(0)
}

// After the script: DONE when it exported nothing; otherwise READY, and each
// INVOKE runs __ae_serve in the same runtime, with the watcher on as it is for
// the script, until END or a cancel. The one watcher started for the script
// keeps running: from before READY or an answer goes out until serve has read
// the host's next frame it is marked as in a call (ghl_watch_call), so an
// INVOKE is not taken for a cancel; starting a
// watcher per invocation cost a thread and a join each time. A cancel heard inside an invocation (the
// watcher's cancel cell, or a call's reply) ends the worker: the function's
// state is half done. (Not named serve: an unqualified call inside child.run's
// callback block resolves to child's own serve.)
fn serve_exports(vm: ptr, w: *Worker) {
    h = w.h
    quickjs.vm_eval(vm, "__ae_ready()")
    names = quickjs.vm_result_str(vm)
    quickjs.vm_pop_result(vm)
    if names == "" {
        child.done(h, 0)
        return
    }
    // Marked before READY goes out, as call_host marks a call before the CALL:
    // the host's INVOKE may arrive at once, and is not unasked.
    ghl_watch_call(w.watch, 1)
    child.ready(h, names)
    while true {
        inv = child.serve(h)
        ghl_watch_call(w.watch, 0)
        if inv.kind == "END" {
            child.done(h, 0)
            return
        }
        if inv.kind != "INVOKE" {
            child.error(h, "cancelled by host: ${inv.args}")
            return
        }
        rc = quickjs.vm_eval(vm, "__ae_serve(${child.json_string(inv.name)})")
        out = quickjs.vm_result_str(vm)
        quickjs.vm_pop_result(vm)
        if h.cancel != "" || out == "InternalError: interrupted: cancelled" {
            why = h.cancel
            if why == "" { why = child.poll(h) }
            child.error(h, "cancelled by host: ${why}")
            return
        }
        if rc != 0 {
            child.error(h, out)
            return
        }
        at = string.index_of(out, "\n")
        text = string.substring(out, at + 1, string.length(out))
        ghl_watch_call(w.watch, 1)
        if string.starts_with(out, "RETURN") == 1 { child.returned(h, text) } else { child.raised(h, text) }
    }
}
