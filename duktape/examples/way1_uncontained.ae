import duktape

main() {
    script = <<JS
        print('HOME     ', env('HOME'));
        print('USER     ', env('USER'));
        print('passwd   ', readFile('/etc/passwd') === undefined ? 'refused' : 'read it');
        print('exec     ', exec('true'));
    JS
    if duktape.run(script) != 0 { println("js failed") }
}
