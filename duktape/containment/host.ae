// The host the containment tests drive (tests/test_stunt_*.sh). Usage:
//
//   host inproc <policy> <check> <expectation>
//
// Runs one row of stunt's catalogue (aether contrib/host/stunt), written in
// JavaScript (checks.js beside this, or $DUKTAPE_CHECKS), in the Duktape
// bridge in this process, under the policy's grants, and prints stunt's line
// for it:
//
//   <check>: <outcome> (<detail>) - expected <expectation>: PASS|FAIL
//
// exiting 0 when it matched. Duktape has no I/O of its own, so there is
// nothing for libaether_sandbox.so (LD_PRELOAD) to hold from the interpreter
// itself: the rows that reach the system do it through the bridge's own
// bindings (env, readFile, writeFile, exec), which check the grants
// themselves, preload or none. Run under the preload anyway, system() (exec)
// is held by it a second time.
//
// Two of the bridge's entry points carry a row:
//   - duktape.run_sandboxed_with_map, the bridge's own sandboxed run, for the
//     rows the bridge's bindings do (open-*, write-*, getenv-home,
//     exec-bin-sh) and the shared-map rows. The line comes back through the
//     map, as an output the script writes.
//   - the two-way VM (duktape.vm_*) inside sandbox.enforce, for the rows that
//     call host functions (binding-*, callback-*). read_file and getenv check
//     the grants themselves, as stunt's host does.
//
// <policy> is "-" for no grants, or kind=pattern,... with kinds fs_read,
// fs_write, exec, env, tcp (host:port), native, fork. "<outer>|<inner>"
// runs the check inside sandbox.enforce(<outer>), so the bridge's level
// nests in the block's. The policy grammar is in policy/module.ae; the
// contained child's host is child_host.ae.

@source("host_support.c")

import duktape
import policy
import std.sandbox
import std.os
import std.fs
import std.list
import std.string

extern exit(code: int)
extern aether_sandbox_depth() -> int
// 1 when every level in force grants it (runtime/aether_sandbox.h).
extern aether_sandbox_check_slow(category: string, resource: string) -> int
extern ghl_map_new() -> long
extern ghl_map_put(key: string, value: string)
extern ghl_map_get(key: string) -> string
extern ghl_stdin_null()

// ---- host functions the guest calls (the two-way VM) ------------------------
//
// A refusal or a failure is an Error thrown into the script, whose message is
// what the script's check reads: "refused: ..." for the grants saying no.

// read_file(path): the file's text, or an Error "refused: ..." when the
// grants do not allow reading it, or an Error with what went wrong.
@c_callback
host_read_file(vm: ptr) -> int {
    path = duktape.arg_str(vm, 1)
    if aether_sandbox_check_slow("fs_read", path) == 0 {
        return duktape.raise_error(vm, "refused: fs_read ${path}")
    }
    text, err = fs.read(path)
    if err != "" {
        return duktape.raise_error(vm, err)
    }
    duktape.push_str(vm, text)
    return 1
}

// getenv(name): the variable, or an Error "refused: ..." when the grants do
// not allow it, or an Error "<name> is unset".
@c_callback
host_getenv(vm: ptr) -> int {
    name = duktape.arg_str(vm, 1)
    if aether_sandbox_check_slow("env", name) == 0 {
        return duktape.raise_error(vm, "refused: env ${name}")
    }
    v = os.getenv(name)
    if v == "" {
        return duktape.raise_error(vm, "${name} is unset")
    }
    duktape.push_str(vm, v)
    return 1
}

@c_callback
host_greet(vm: ptr) -> int {
    duktape.push_str(vm, "hello, ${duktape.arg_str(vm, 1)}")
    return 1
}

@c_callback
host_add(vm: ptr) -> int {
    if duktape.arg_type(vm, 1) != duktape.DUK_TINT || duktape.arg_type(vm, 2) != duktape.DUK_TINT {
        return duktape.raise_error(vm, "add takes two ints")
    }
    duktape.push_int(vm, duktape.arg_int(vm, 1) + duktape.arg_int(vm, 2))
    return 1
}

// ---- the rows ---------------------------------------------------------------

// Which entry point carries a row: the two-way VM for host functions, the
// bridge's sandboxed run for the rest.
fn uses_vm(check: string) -> int {
    if string.starts_with(check, "binding-") == 1 { return 1 }
    if string.starts_with(check, "callback-") == 1 { return 1 }
    return 0
}

fn run_vm(g: sandbox.Grants, check: string, expect: string, source: string) -> string {
    vm = duktape.vm_new()
    if vm == null {
        println("host: cannot load libduktape (AETHER_DUKTAPE_SONAME)")
        exit(1)
    }
    duktape.vm_register(vm, "read_file", host_read_file)
    duktape.vm_register(vm, "getenv", host_getenv)
    duktape.vm_register(vm, "greet", host_greet)
    duktape.vm_register(vm, "add", host_add)
    box = list.new()
    sandbox.enforce(g) callback {
        rc = duktape.vm_eval(vm, "${source}\ncheck_line(\"${check}\", \"${expect}\")")
        if rc != 0 {
            list.add(box, "${check}: the script failed (${duktape.vm_result_str(vm)}) - expected ${expect}: FAIL")
        } else {
            list.add(box, duktape.vm_result_str(vm))
        }
    }
    out, _e = list.get_string(box, 0)
    return out
}

fn run_bridge(g: sandbox.Grants, check: string, expect: string, source: string) -> string {
    token = ghl_map_new()
    ghl_map_put("input", "stunt-in")
    rc = duktape.run_sandboxed_with_map(g, "${source}\naether_map_put(\"line\", check_line(\"${check}\", \"${expect}\"));", token)
    line = ghl_map_get("line")
    if rc != 0 || line == "" {
        return "${check}: the script failed (run_sandboxed_with_map returned ${rc}) - expected ${expect}: FAIL"
    }
    return line
}

fn run_row(g: sandbox.Grants, check: string, expect: string, source: string) -> string {
    if uses_vm(check) == 1 { return run_vm(g, check, expect, source) }
    return run_bridge(g, check, expect, source)
}

fn finish(line: string, before: int, check: string) {
    after = aether_sandbox_depth()
    if after != before {
        println("host: ${check}: the bridge left ${after - before} level(s) in force")
        exit(1)
    }
    println(line)
    exit(policy.verdict(line))
}

fn run_inproc(spec: string, check: string, expect: string) {
    source = "${policy.facts()}${policy.checks_source()}"
    bar = string.index_of(spec, "|")
    if bar < 0 {
        before = aether_sandbox_depth()
        finish(run_row(policy.grants(spec), check, expect, source), before, check)
        return
    }
    outer = policy.grants(string.substring(spec, 0, bar))
    inner = policy.grants(string.substring(spec, bar + 1, string.length(spec)))
    sandbox.enforce(outer) callback {
        if aether_sandbox_depth() != 1 {
            println("host: the enforce block is not one level deep")
            exit(1)
        }
        before = aether_sandbox_depth()
        finish(run_row(inner, check, expect, source), before, check)
    }
}


main() {
    if os.args_count() != 5 {
        println("usage: host inproc <policy> <check> <expectation>")
        exit(2)
    }
    mode = os.args_get(1)
    if mode == "inproc" {
        ghl_stdin_null()
        run_inproc(os.args_get(2), os.args_get(3), os.args_get(4))
    } else {
        println("host: unknown mode ${mode}")
        exit(2)
    }
}
