// ruby-worker: CRuby in a contained child, the guest's side of std.guest.
//
// A host starts this with guest.launch (sandbox.spawn_socket: Landlock and
// seccomp on Linux; refused on macOS and Windows, where nothing starts) and
// sends it the functions it may call (MOUNT) and a Ruby script (SCRIPT). The
// worker loads libruby and starts the interpreter before it locks itself
// down, requires the libraries the host names, then runs the script in the
// bridge inside std.guest.child's lockdown:
//
//   puts, print, $stdout.write, p ...   SAY, the arguments joined; $stdout is
//                       replaced by an object that says rather than writes
//   NAME(...)           for each mounted NAME: CALL NAME [args as JSON], the
//                       host's answer decoded back to Ruby (a granted file is
//                       {"granted" => true, "text" => ...}); a FAIL raises
//                       RuntimeError(message); a CANCEL raises
//                       RuntimeError("cancelled by host: ...")
//   the end             DONE 0, or ERROR and "<ExceptionClass>: <message>"
//
// Usage (by a host): ruby-worker [<libruby soname or path> [<libraries> [gems]]]
//
// <libraries> is a comma list of libraries to require before the lockdown.
// Ruby reads a library from disk the first time it is required; once the
// worker has locked itself down it can read nothing, so a require of a
// library not loaded by then fails (LoadError). So do the encodings Ruby
// loads on demand (enc/*.so: String#encode to UTF-16, say). The
// interpreter's own start happens before the lockdown too. Features built
// into the interpreter need no disk.
//
// export :name marks a method (export def name ... end), and export(:name)
// { |...| } a block, for the host to call by name once the script has ended. A
// script that exported anything ends with READY and its names instead of
// DONE, and serves: each INVOKE calls it with its JSON arguments in the same
// interpreter (the script's globals, constants and closures as it left them)
// and is answered RETURN and the value as JSON, or RAISE and "<Class>:
// <message>", after which it serves on; END ends it with DONE 0. The names
// are fixed at READY. `export` is the worker's: a host cannot mount it.
//
// A CANCEL is looked for every 1000 line, call and block events from a TracePoint hook, and
// in every call's reply. A script that disables the hook (ObjectSpace
// reaches it) stops answering, and the host kills it after its grace period:
// the containment is the host's, not the hook's.

import ruby
import std.guest.child
import std.os
import std.string

extern exit(code: int)
extern setenv(name: string, value: string, overwrite: int) -> int
extern ghl_keep(p: ptr)
extern ghl_kept() -> ptr

@source("worker_support.c")

// The Host the callbacks below answer through (one per process).
fn host() -> *child.Host {
    return ghl_kept() as *child.Host
}

// __say(text)
@c_callback
w_say(ctx: ptr) -> int {
    child.say(host(), ruby.arg_str(ctx, 1))
    return 0
}

// __call(name, args_json) -> "KIND\ntext"
@c_callback
w_call(ctx: ptr) -> int {
    r = child.call_host(host(), ruby.arg_str(ctx, 1), ruby.arg_str(ctx, 2))
    ruby.push_str(ctx, "${r.kind}\n${r.text}")
    return 1
}

// __poll() -> "" or the reason the host cancelled
@c_callback
w_poll(ctx: ptr) -> int {
    ruby.push_str(ctx, child.poll(host()))
    return 1
}

// __args() -> the arguments of the invocation being served, a JSON array
@c_callback
w_args(ctx: ptr) -> int {
    ruby.push_str(ctx, host().invoked)
    return 1
}

// The glue between Ruby and the protocol, run before the script.
fn prelude() -> string {
    return <<RB
require 'json'

# Ruby loads a transcoder from disk the first time one is needed
# (enc/trans/*.so), which the locked-down worker cannot read. Ruby 3.0's json
# reaches the single-byte one for a string that is not ASCII (seen on Ubuntu
# 22.04's Ruby 3.0: LoadError for enc/trans/single_byte), so it is loaded here,
# before the lockdown, with the paths JSON takes.
"\u00e9".encode(Encoding::ISO_8859_1).encode(Encoding::UTF_8)
JSON.generate(["\u00e9 \u{1F600}", "a".b])

module AetherGuest
  SAY = method(:__say)
  CALL = method(:__call)
  POLL = method(:__poll)
  ARGS = method(:__args)

  # Exports: what the host may call by name once the script has ended.
  EXPORTS = {}
  SERVED = {}

  # The names at READY, fixed from here on, as a JSON array; "" for none.
  # The script's text is UTF-8, but Ruby 3.0 evaluates it with its string
  # literals tagged ASCII-8BIT, which JSON refuses to convert ("\xC3" from
  # ASCII-8BIT): such a string is read as the UTF-8 it is. Later Rubies tag
  # them UTF-8 already, and nothing changes there.
  def self.utf8(v)
    case v
    when String then v.encoding == Encoding::ASCII_8BIT ? v.dup.force_encoding(Encoding::UTF_8) : v
    when Array then v.map { |x| utf8(x) }
    when Hash then v.each_with_object({}) { |(k, x), h| h[utf8(k)] = utf8(x) }
    else v
    end
  end

  def self.ready
    SERVED.replace(EXPORTS)
    SERVED.empty? ? "" : JSON.generate(SERVED.keys)
  end

  # One INVOKE: "RETURN\n<json>" or "RAISE\n<Class>: <message>".
  def self.serve(name)
    fn = SERVED[name]
    return "RAISE\nNameError: no export named #{name}" unless fn
    "RETURN\n" + JSON.generate(utf8(fn.call(*JSON.parse(ARGS.call))))
  rescue StandardError => e
    "RAISE\n#{e.class}: #{e.message}"
  end

  # $stdout: what the script prints is a SAY.
  class Out
    def write(*a); s = a.join; SAY.call(s); s.bytesize; end
    def print(*a); SAY.call(a.join); nil; end
    def puts(*a)
      lines = a.empty? ? [""] : a.flatten.map { |x| x.to_s.chomp }
      SAY.call(lines.join("\n")); nil
    end
    def <<(x); SAY.call(x.to_s); self; end
    def printf(f, *a); SAY.call(format(f, *a)); nil; end
    def flush; self; end
    def sync; true; end
    def sync=(v); v; end
    def tty?; false; end
    def fileno; 1; end
  end

  # A mounted function is a private method of Object: the host's call.
  def self.mount(name)
    Object.send(:define_method, name) do |*args|
      kind, text = CALL.call(name.to_s, JSON.generate(AetherGuest.utf8(args))).split("\n", 2)
      text ||= ""
      case kind
      when "VALUE" then JSON.parse("[#{text}]")[0]
      when "CANCEL" then raise "cancelled by host: #{text}"
      else raise text
      end
    end
    Object.send(:private, name)
  end

  EVENTS = [0]
  HOOK = TracePoint.new(:line, :call, :c_call, :b_call) do
    EVENTS[0] += 1
    if EVENTS[0] % 1000 == 0
      why = POLL.call
      raise "cancelled by host: #{why}" unless why.empty?
    end
  end
end

# export :name (a method; `export def name ... end` reads naturally), or
# export(:name) { |...| ... } for a block.
class Object
  private def export(*names, &blk)
    if blk
      raise ArgumentError, "export: one name with a block" unless names.size == 1
      AetherGuest::EXPORTS[names[0].to_s] = blk
    else
      names.each { |n| AetherGuest::EXPORTS[n.to_s] = method(n) }
    end
    nil
  end
end

$stdout = AetherGuest::Out.new
AETHER_MOUNTS.each { |n| AetherGuest.mount(n) }
Object.send(:remove_const, :AETHER_MOUNTS)
[:__say, :__call, :__poll, :__args].each { |m| Object.send(:remove_method, m) }
AetherGuest::HOOK.enable
nil
RB
}

// The mounted names, as a Ruby array literal.
fn mounts_rb(h: *child.Host) -> string {
    out = "AETHER_MOUNTS = ["
    n = child.mount_count(h)
    i = 0
    while i < n {
        name, _min, _max = child.mount_at(h, i)
        out = "${out}\"${name}\","
        i = i + 1
    }
    return "${out}]\n"
}

main() {
    h, err = child.open("ruby-worker")
    if err != "" {
        println(err)
        exit(2)
    }
    if child.read_script(h) != "" { exit(1) }
    // libruby is loaded and the interpreter started here, before the
    // lockdown: afterwards the worker opens nothing. guest.launch gives the
    // worker no environment, so the host names the library as the first
    // argument.
    if os.args_count() > 1 && os.args_get(1) != "" {
        setenv("AETHER_RUBY_SONAME", os.args_get(1), 1)
    }
    // From Ruby 3.5 (4.0 among them) fiddle is a bundled gem, which `require`
    // finds only once RubyGems is loaded, and the bridge starts without it
    // unless AETHER_RUBY_GEMS is set (aether_host_ruby.c). The worker has no
    // environment, so the host says so in a third argument, "gems", before the
    // lockdown (while the gem directories can be read). Not for every Ruby:
    // with RubyGems loaded a require the lockdown refuses fails with a
    // NameError instead of a LoadError.
    if os.args_count() > 3 && os.args_get(3) == "gems" {
        setenv("AETHER_RUBY_GEMS", "1", 1)
    }
    if ruby.init_host() != 0 {
        child.error(h, "ruby-worker: cannot load libruby (AETHER_RUBY_SONAME)")
        exit(1)
    }
    if os.args_count() > 2 && os.args_get(2) != "" {
        libs = os.args_get(2)
        if ruby.eval("'${libs}'.split(',').each { |l| require l }; nil") != 0 {
            child.error(h, "ruby-worker: cannot require ${libs}: ${ruby.result_str()}")
            exit(1)
        }
    }
    if child.is_mounted(h, "export") {
        child.error(h, "ruby-worker: cannot mount 'export': the worker defines it for the script")
        exit(1)
    }
    ghl_keep(h as ptr)
    ruby.register("__args", w_args)
    ruby.register("__say", w_say)
    ruby.register("__call", w_call)
    ruby.register("__poll", w_poll)
    if ruby.eval("${mounts_rb(h)}${prelude()}") != 0 {
        child.error(h, "ruby-worker: the prelude failed: ${ruby.result_str()}")
        exit(1)
    }
    child.run(h) callback {
        if ruby.eval(h.source) == 0 {
            serve_guest(h)
        } else {
            child.error(h, ruby.result_str())
        }
    }
    exit(0)
}

// After the script: DONE when it exported nothing; otherwise READY, and
// std.guest.child's serve_exports runs, for each INVOKE, AetherGuest.serve in
// the same interpreter until END or a cancel. A cancel heard inside an
// invocation (the TracePoint, or a call's reply) ends the worker: the
// method's state is half done. std.guest.child's serve_exports sends the
// answer: a value too large for the host's frame is raised and the worker
// serves on. (Named serve_guest: an unqualified call inside child.run's
// callback block resolves to a std.guest.child export of the same name, such
// as serve or serve_exports.)
fn serve_guest(h: *child.Host) {
    if ruby.eval("AetherGuest.ready") != 0 {
        child.error(h, ruby.result_str())
        return
    }
    names = ruby.result_str()
    if names == "" {
        child.done(h, 0)
        return
    }
    child.ready(h, names)
    child.serve_exports(h) callback | sh: *child.Host, inv: child.Invocation | {
        if ruby.eval("AetherGuest.serve(${child.json_string(inv.name)})") != 0 {
            return child.Reply { kind: "FAIL", text: ruby.result_str() }
        }
        out = ruby.result_str()
        at = string.index_of(out, "\n")
        text = string.substring(out, at + 1, string.length(out))
        if string.starts_with(out, "RETURN") == 1 { return child.Reply { kind: "VALUE", text: text } }
        return child.Reply { kind: "FAIL", text: text }
    }
}
