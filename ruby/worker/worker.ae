// ruby-worker: CRuby in a contained child, the guest's side of std.guest.
//
// A host starts this with guest.launch (sandbox.spawn_socket: Landlock and
// seccomp on Linux; refused on macOS and Windows, where nothing starts) and
// sends it the functions it may call (MOUNT) and a Ruby script (SCRIPT). The
// worker loads libruby and starts the interpreter before it locks itself
// down, requires the libraries the host names, then runs the script in the
// bridge inside std.guest.child's lockdown:
//
//   puts, print, $stdout.write, p ...   SAY, the arguments joined; $stdout is
//                       replaced by an object that says rather than writes
//   NAME(...)           for each mounted NAME: CALL NAME [args as JSON], the
//                       host's answer decoded back to Ruby (a granted file is
//                       {"granted" => true, "text" => ...}); a FAIL raises
//                       RuntimeError(message); a CANCEL raises
//                       RuntimeError("cancelled by host: ...")
//   the end             DONE 0, or ERROR and "<ExceptionClass>: <message>"
//
// Usage (by a host): ruby-worker [<libruby soname or path> [<libraries>]]
//
// <libraries> is a comma list of libraries to require before the lockdown.
// Ruby reads a library from disk the first time it is required; once the
// worker has locked itself down it can read nothing, so a require of a
// library not loaded by then fails (LoadError). So do the encodings Ruby
// loads on demand (enc/*.so: String#encode to UTF-16, say). The
// interpreter's own start happens before the lockdown too. Features built
// into the interpreter need no disk.
//
// A CANCEL is looked for every 1000 line, call and block events from a TracePoint hook, and
// in every call's reply. A script that disables the hook (ObjectSpace
// reaches it) stops answering, and the host kills it after its grace period:
// the containment is the host's, not the hook's.

import ruby
import std.guest.child
import std.os
import std.string

extern exit(code: int)
extern setenv(name: string, value: string, overwrite: int) -> int
extern ghl_keep(p: ptr)
extern ghl_kept() -> ptr

@source("worker_support.c")

// The Host the callbacks below answer through (one per process).
fn host() -> *child.Host {
    return ghl_kept() as *child.Host
}

// __say(text)
@c_callback
w_say(ctx: ptr) -> int {
    child.say(host(), ruby.arg_str(ctx, 1))
    return 0
}

// __call(name, args_json) -> "KIND\ntext"
@c_callback
w_call(ctx: ptr) -> int {
    r = child.call_host(host(), ruby.arg_str(ctx, 1), ruby.arg_str(ctx, 2))
    ruby.push_str(ctx, "${r.kind}\n${r.text}")
    return 1
}

// __poll() -> "" or the reason the host cancelled
@c_callback
w_poll(ctx: ptr) -> int {
    ruby.push_str(ctx, child.poll(host()))
    return 1
}

// The glue between Ruby and the protocol, run before the script.
fn prelude() -> string {
    return <<RB
require 'json'

module AetherGuest
  SAY = method(:__say)
  CALL = method(:__call)
  POLL = method(:__poll)

  # $stdout: what the script prints is a SAY.
  class Out
    def write(*a); s = a.join; SAY.call(s); s.bytesize; end
    def print(*a); SAY.call(a.join); nil; end
    def puts(*a)
      lines = a.empty? ? [""] : a.flatten.map { |x| x.to_s.chomp }
      SAY.call(lines.join("\n")); nil
    end
    def <<(x); SAY.call(x.to_s); self; end
    def printf(f, *a); SAY.call(format(f, *a)); nil; end
    def flush; self; end
    def sync; true; end
    def sync=(v); v; end
    def tty?; false; end
    def fileno; 1; end
  end

  # A mounted function is a private method of Object: the host's call.
  def self.mount(name)
    Object.send(:define_method, name) do |*args|
      kind, text = CALL.call(name.to_s, JSON.generate(args)).split("\n", 2)
      text ||= ""
      case kind
      when "VALUE" then JSON.parse("[#{text}]")[0]
      when "CANCEL" then raise "cancelled by host: #{text}"
      else raise text
      end
    end
    Object.send(:private, name)
  end

  EVENTS = [0]
  HOOK = TracePoint.new(:line, :call, :c_call, :b_call) do
    EVENTS[0] += 1
    if EVENTS[0] % 1000 == 0
      why = POLL.call
      raise "cancelled by host: #{why}" unless why.empty?
    end
  end
end

$stdout = AetherGuest::Out.new
AETHER_MOUNTS.each { |n| AetherGuest.mount(n) }
Object.send(:remove_const, :AETHER_MOUNTS)
[:__say, :__call, :__poll].each { |m| Object.send(:remove_method, m) }
AetherGuest::HOOK.enable
nil
RB
}

// The mounted names, as a Ruby array literal.
fn mounts_rb(h: *child.Host) -> string {
    out = "AETHER_MOUNTS = ["
    n = child.mount_count(h)
    i = 0
    while i < n {
        name, _min, _max = child.mount_at(h, i)
        out = "${out}\"${name}\","
        i = i + 1
    }
    return "${out}]\n"
}

main() {
    h, err = child.open("ruby-worker")
    if err != "" {
        println(err)
        exit(2)
    }
    if child.read_script(h) != "" { exit(1) }
    // libruby is loaded and the interpreter started here, before the
    // lockdown: afterwards the worker opens nothing. guest.launch gives the
    // worker no environment, so the host names the library as the first
    // argument.
    if os.args_count() > 1 && os.args_get(1) != "" {
        setenv("AETHER_RUBY_SONAME", os.args_get(1), 1)
    }
    if ruby.init_host() != 0 {
        child.error(h, "ruby-worker: cannot load libruby (AETHER_RUBY_SONAME)")
        exit(1)
    }
    if os.args_count() > 2 && os.args_get(2) != "" {
        libs = os.args_get(2)
        if ruby.eval("'${libs}'.split(',').each { |l| require l }; nil") != 0 {
            child.error(h, "ruby-worker: cannot require ${libs}: ${ruby.result_str()}")
            exit(1)
        }
    }
    ghl_keep(h as ptr)
    ruby.register("__say", w_say)
    ruby.register("__call", w_call)
    ruby.register("__poll", w_poll)
    if ruby.eval("${mounts_rb(h)}${prelude()}") != 0 {
        child.error(h, "ruby-worker: the prelude failed: ${ruby.result_str()}")
        exit(1)
    }
    child.run(h) callback {
        if ruby.eval(h.source) == 0 {
            child.done(h, 0)
        } else {
            child.error(h, ruby.result_str())
        }
    }
    exit(0)
}
