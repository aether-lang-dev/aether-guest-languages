// The host the containment tests drive (tests/test_stunt_*.sh). Usage:
//
//   host inproc <policy> <check> <expectation>
//
// Runs one row of stunt's catalogue (aether contrib/host/stunt), written in
// Ruby (checks.rb beside this, or $RUBY_CHECKS), in the Ruby bridge in
// this process, under the policy's grants, and prints stunt's line for it:
//
//   <check>: <outcome> (<detail>) - expected <expectation>: PASS|FAIL
//
// exiting 0 when it matched. Run it under libaether_sandbox.so (LD_PRELOAD)
// for Ruby's own libc calls (File.open, connect, getenv through Fiddle, the
// shell, dlopen) to be checked: in-process, nothing else sees them.
//
// Two of the bridge's entry points carry a row:
//   - ruby.run_sandboxed_with_map, the bridge's own sandboxed run, for the
//     rows Ruby's standard library does (open-*, write-*, getenv-home,
//     env-cached, connect-*, exec-bin-sh, dlopen-libm) and the shared-map
//     rows. The line comes back through the map, as an output the script
//     writes.
//   - ruby.register and ruby.eval inside sandbox.enforce, for the rows
//     that call host functions (binding-*, callback-*) and for spin, which
//     needs the instruction limit. read_file and getenv check the grants
//     themselves, as stunt's host does, and refuse by raising
//     RuntimeError("refused: ...").
//
// Before either, the libraries checks.rb requires are required with no
// sandbox in force, as a host does for a script it lends them to: under a
// policy with no read grant on the standard library, a library that is not
// loaded yet cannot be (ruby/README.md).
//
// <policy> is "-" for no grants, or kind=pattern,... with kinds fs_read,
// fs_write, exec, env, tcp (host:port), native, fork. "<outer>|<inner>"
// runs the check inside sandbox.enforce(<outer>), so the bridge's level
// nests in the block's. The policy grammar is in policy/module.ae; the
// contained child's host is child_host.ae.

@source("host_support.c")

import ruby
import policy
import std.sandbox
import std.os
import std.fs
import std.list
import std.string

extern exit(code: int)
extern aether_sandbox_depth() -> int
// 1 when every level in force grants it (runtime/aether_sandbox.h).
extern aether_sandbox_check_slow(category: string, resource: string) -> int
extern ghl_map_new() -> long
extern ghl_map_put(key: string, value: string)
extern ghl_map_get(key: string) -> string

// The libraries checks.rb requires, required before any sandbox.
const PREIMPORT = "require 'rbconfig'; require 'socket'; require 'fiddle'; require 'json'; nil"

// ---- host functions the guest calls (ruby.register) -------------------------

// read_file(path): the file's text; raises "refused: ..." when the grants do
// not allow reading it, or the error.
@c_callback
host_read_file(ctx: ptr) -> int {
    path = ruby.arg_str(ctx, 1)
    if aether_sandbox_check_slow("fs_read", path) == 0 {
        return ruby.raise_error(ctx, "refused: fs_read ${path}")
    }
    text, err = fs.read(path)
    if err != "" { return ruby.raise_error(ctx, err) }
    ruby.push_str(ctx, text)
    return 1
}

// getenv(name): the variable; raises "refused: ..." when the grants do not
// allow it, or "<name> is unset".
@c_callback
host_getenv(ctx: ptr) -> int {
    name = ruby.arg_str(ctx, 1)
    if aether_sandbox_check_slow("env", name) == 0 {
        return ruby.raise_error(ctx, "refused: env ${name}")
    }
    v = os.getenv(name)
    if v == "" { return ruby.raise_error(ctx, "${name} is unset") }
    ruby.push_str(ctx, v)
    return 1
}

@c_callback
host_greet(ctx: ptr) -> int {
    ruby.push_str(ctx, "hello, ${ruby.arg_str(ctx, 1)}")
    return 1
}

@c_callback
host_add(ctx: ptr) -> int {
    if ruby.arg_type(ctx, 1) != ruby.RB_TINT || ruby.arg_type(ctx, 2) != ruby.RB_TINT {
        return ruby.raise_error(ctx, "add takes two ints")
    }
    ruby.push_int(ctx, ruby.arg_int(ctx, 1) + ruby.arg_int(ctx, 2))
    return 1
}

// ---- the rows ---------------------------------------------------------------

// Which entry point carries a row: the two-way VM for host functions and
// spin, the bridge's sandboxed run for the rest.
fn uses_vm(check: string) -> int {
    if string.starts_with(check, "binding-") == 1 { return 1 }
    if string.starts_with(check, "callback-") == 1 { return 1 }
    if check == "spin" { return 1 }
    return 0
}

fn run_vm(g: sandbox.Grants, check: string, expect: string, source: string) -> string {
    if ruby.init_host() != 0 {
        println("host: cannot load libruby (AETHER_RUBY_SONAME)")
        exit(1)
    }
    ruby.register("read_file", host_read_file)
    ruby.register("getenv", host_getenv)
    ruby.register("greet", host_greet)
    ruby.register("add", host_add)
    box = list.new()
    if check == "spin" {
        ruby.set_instruction_limit(50000)
        sandbox.enforce(g) callback {
            rc = ruby.eval("${source}\nloop do\n  _x = 1\nend\n")
            list.add(box, "${rc}\t${ruby.result_str()}")
        }
        out, _e = list.get_string(box, 0)
        tab = string.index_of(out, "\t")
        rc_text = string.substring(out, 0, tab)
        msg = string.substring(out, tab + 1, string.length(out))
        if rc_text != "0" && string.contains(msg, "instruction limit exceeded") == 1 {
            return "spin: stopped at the instruction limit (${msg}) - host-checked: PASS"
        }
        return "spin: rc ${rc_text} (${msg}) - host-checked: FAIL"
    }
    sandbox.enforce(g) callback {
        rc = ruby.eval(source)
        if rc == 0 {
            rc = ruby.eval("check_line(\"${check}\", \"${expect}\")")
        }
        if rc != 0 {
            list.add(box, "${check}: the script failed (${ruby.result_str()}) - expected ${expect}: FAIL")
        } else {
            list.add(box, ruby.result_str())
        }
    }
    out, _e = list.get_string(box, 0)
    return out
}

fn run_bridge(g: sandbox.Grants, check: string, expect: string, source: string) -> string {
    token = ghl_map_new()
    ghl_map_put("input", "stunt-in")
    rc = ruby.run_sandboxed_with_map(g, "${source}\naether_map_put(\"line\", check_line(\"${check}\", \"${expect}\"))\n", token)
    line = ghl_map_get("line")
    if rc != 0 || line == "" {
        return "${check}: the script failed (run_sandboxed_with_map returned ${rc}) - expected ${expect}: FAIL"
    }
    return line
}

fn run_row(g: sandbox.Grants, check: string, expect: string, source: string) -> string {
    if uses_vm(check) == 1 { return run_vm(g, check, expect, source) }
    return run_bridge(g, check, expect, source)
}

fn finish(line: string, before: int, check: string) {
    after = aether_sandbox_depth()
    if after != before {
        println("host: ${check}: the bridge left ${after - before} level(s) in force")
        exit(1)
    }
    println(line)
    exit(policy.verdict(line))
}

fn run_inproc(spec: string, check: string, expect: string) {
    source = "${policy.facts()}${policy.checks_source()}"
    if ruby.run(PREIMPORT) != 0 {
        println("host: cannot require what checks.rb needs (${PREIMPORT})")
        exit(1)
    }
    bar = string.index_of(spec, "|")
    if bar < 0 {
        before = aether_sandbox_depth()
        finish(run_row(policy.grants(spec), check, expect, source), before, check)
        return
    }
    outer = policy.grants(string.substring(spec, 0, bar))
    inner = policy.grants(string.substring(spec, bar + 1, string.length(spec)))
    sandbox.enforce(outer) callback {
        if aether_sandbox_depth() != 1 {
            println("host: the enforce block is not one level deep")
            exit(1)
        }
        before = aether_sandbox_depth()
        finish(run_row(inner, check, expect, source), before, check)
    }
}

main() {
    if os.args_count() != 5 {
        println("usage: host inproc <policy> <check> <expectation>")
        exit(2)
    }
    mode = os.args_get(1)
    if mode == "inproc" {
        run_inproc(os.args_get(2), os.args_get(3), os.args_get(4))
    } else {
        println("host: unknown mode ${mode}")
        exit(2)
    }
}
